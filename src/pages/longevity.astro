  <!-- INTERACTIVE JS SCRIPTS -->
  <script is:inline>
    document.addEventListener('astro:page-load', () => {
      // ─── 1. INTERACTIVE SVG CHART TOOLTIP ───
      const dots = document.querySelectorAll('.interactive-dot');
      const tooltip = document.getElementById('chart-tooltip');
      const chartContainer = document.querySelector('.chart-container');

      dots.forEach(dot => {
        dot.addEventListener('mouseenter', (e) => {
          const title = dot.getAttribute('data-title');
          const desc = dot.getAttribute('data-desc');
          
          tooltip.innerHTML = `<strong>${title}</strong>${desc}`;
          tooltip.style.opacity = '1';
          
          // Calculate relative positioning
          const containerRect = chartContainer.getBoundingClientRect();
          const dotRect = dot.getBoundingClientRect();
          const left = dotRect.left - containerRect.left + dotRect.width / 2;
          const top = dotRect.top - containerRect.top;

          tooltip.style.left = `${left}px`;
          tooltip.style.top = `${top}px`;
        });

        dot.addEventListener('mouseleave', () => {
          tooltip.style.opacity = '0';
        });
      });

      // ─── 2. 6 ALAN (AKORDEON) ───
      const pillars = [...document.querySelectorAll('.pillar-item')];
      const setOpen = (pillar, open) => {
        pillar.classList.toggle('active', open);
        pillar.querySelector('.pillar-trigger').setAttribute('aria-expanded', String(open));
        const content = pillar.querySelector('.pillar-content');
        content.style.maxHeight = open ? content.scrollHeight + 'px' : null;
      };
      const openOnly = (target) => pillars.forEach((p) => setOpen(p, p === target));

      // /longevity#uyku gibi bir adresle gelindiyse o alanı, yoksa ilk alanı aç.
      const fromHash = () => pillars.find((p) => '#' + p.id === location.hash);
      if (pillars.length) openOnly(fromHash() ?? pillars[0]);
      // Aynı sayfadaki #alan bağlantıları (ör. menü). Astro yönlendiricisi bu tıklamalarda
      // hashchange tetiklemediği için tıklamayı dinliyoruz; dinleyici bir kez bağlanır.
      if (!window.__longevityHashLinks) {
        window.__longevityHashLinks = true;
        document.addEventListener('click', (event) => {
          const link = event.target.closest && event.target.closest('a[href*="#"]');
          if (!link) return;
          const url = new URL(link.href, location.href);
          if (url.pathname !== location.pathname) return;
          const target = document.getElementById(url.hash.slice(1));
          if (target && target.classList.contains('pillar-item') && !target.classList.contains('active')) {
            target.querySelector('.pillar-trigger').click();
          }
        });
      }

      pillars.forEach((pillar) => {
        pillar.querySelector('.pillar-trigger').addEventListener('click', () => {
          const isActive = pillar.classList.contains('active');
          openOnly(isActive ? null : pillar);
        });
      });
    });
  </script>
