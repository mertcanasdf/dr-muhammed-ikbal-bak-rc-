  <!-- INTERACTIVE JS SCRIPTS -->
  <script is:inline>
    document.addEventListener('astro:page-load', () => {
      // ─── 1. INTERACTIVE SVG CHART TOOLTIP ───
      const dots = document.querySelectorAll('.interactive-dot');
      const tooltip = document.getElementById('chart-tooltip');
      const chartContainer = document.querySelector('.chart-container');

      dots.forEach(dot => {
        dot.addEventListener('mouseenter', (e) => {
          const title = dot.getAttribute('data-title');
          const desc = dot.getAttribute('data-desc');
          
          tooltip.innerHTML = `<strong>${title}</strong>${desc}`;
          tooltip.style.opacity = '1';
          
          // Calculate relative positioning
          const containerRect = chartContainer.getBoundingClientRect();
          const dotRect = dot.getBoundingClientRect();
          const left = dotRect.left - containerRect.left + dotRect.width / 2;
          const top = dotRect.top - containerRect.top;

          tooltip.style.left = `${left}px`;
          tooltip.style.top = `${top}px`;
        });

        dot.addEventListener('mouseleave', () => {
          tooltip.style.opacity = '0';
        });
      });

      // ─── 2. EXPANDABLE 5 PILLARS ───
      const pillars = document.querySelectorAll('.pillar-item');
      
      // Open the first pillar by default
      if (pillars.length > 0) {
        const firstPillar = pillars[0];
        const content = firstPillar.querySelector('.pillar-content');
        firstPillar.classList.add('active');
        content.style.maxHeight = content.scrollHeight + "px";
      }

      pillars.forEach(pillar => {
        const trigger = pillar.querySelector('.pillar-trigger');
        const content = pillar.querySelector('.pillar-content');

        trigger.addEventListener('click', () => {
          const isActive = pillar.classList.contains('active');

          // Close all pillars
          pillars.forEach(p => {
            p.classList.remove('active');
            p.querySelector('.pillar-content').style.maxHeight = null;
          });

          // Toggle current
          if (!isActive) {
            pillar.classList.add('active');
            content.style.maxHeight = content.scrollHeight + "px";
          }
        });
      });
    });
  </script>
