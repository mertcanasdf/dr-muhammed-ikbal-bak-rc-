    <script is:inline>
      function switchArticleTab(btn, tab) {
        document.querySelectorAll('.articles-tabs__btn').forEach(function(b) {
          b.setAttribute('aria-selected', 'false');
        });
        document.querySelectorAll('.articles-panel').forEach(function(p) {
          p.classList.remove('is-active');
        });
        btn.setAttribute('aria-selected', 'true');
        document.getElementById('panel-' + tab).classList.add('is-active');
      }
    </script>

