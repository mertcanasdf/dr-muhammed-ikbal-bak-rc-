---
import { getArticleMetrics } from '../../lib/article-metrics';
import CardImage from '../../components/CardImage.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { sortPostsNewestFirst } from '../../lib/posts';
import { BLOG_CATEGORIES } from '../../lib/categories';

const posts = sortPostsNewestFirst(await getCollection('blog'));

function formatDate(date: Date): string {
  return date.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
}

const slug = (id: string) => id.replace(/\.mdx?$/, '');
---
<BaseLayout title="Sağlık ve Longevity Makaleleri — Dr. Muhammed İkbal Bakırcı" pageType="CollectionPage">
  <section class="blog-hero">
    <div class="container">
      <h1 class="blog-hero__title">Sağlık ve Longevity Makaleleri</h1>
      <p class="blog-hero__sub">Longevity bilimi, beslenme, hareket, uyku, zihin ve skin longevity üzerine bilimsel temelli, Türkçe içerikler.</p>
      <div class="blog-filters" id="blogFilters">
        <button class="filter-btn active" data-filter="all">Tümü</button>
        {BLOG_CATEGORIES.map((cat) => <button class="filter-btn" data-filter={cat}>{cat}</button>)}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container">
      <p class="blog-search-status" id="blogSearchStatus" role="status" hidden></p>
      <div class="blog-grid" id="blogGrid">
        {posts.map(post => (
          <article class="blog-card" data-cat={post.data.category} data-title={post.data.title} data-desc={`${post.data.description} ${(post.data.takeaways ?? []).join(' ')}`}>
            <a href={`/blog/${slug(post.id)}`} class="blog-card__img-link">
              <CardImage src={post.data.image} alt={post.data.title} class="blog-card__img" />
            </a>
            <div class="blog-card__body">
              <span class="blog-card__cat">{post.data.category}</span>
              <h2 class="blog-card__title">
                <a href={`/blog/${slug(post.id)}`}>{post.data.title}</a>
              </h2>
              <p class="blog-card__excerpt">{post.data.description}</p>
              <div class="blog-card__meta">
                <span>{formatDate(post.data.date)}</span>
                <span>{getArticleMetrics(post.body ?? '').readTime} okuma</span>
              </div>
              <a href={`/blog/${slug(post.id)}`} class="blog-card__read-more">Devamını oku &rarr;</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
<script is:inline>
  document.addEventListener('astro:page-load', function () {
    var btns  = document.querySelectorAll('.filter-btn');
    var grid  = document.getElementById('blogGrid');
    var cards = Array.prototype.slice.call(document.querySelectorAll('#blogGrid .blog-card'));

    // Türkçe karakterleri ve çift harfleri sadeleştirir: "Güneş"/"gunes", "kollajen"/"kolajen" aynı aranır.
    function fold(s) {
      return s.toLocaleLowerCase('tr')
        .replace(/ı/g, 'i').replace(/ğ/g, 'g').replace(/ü/g, 'u')
        .replace(/ş/g, 's').replace(/ö/g, 'o').replace(/ç/g, 'c')
        .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
        .replace(/([a-z])\1+/g, '$1');
    }

    // Başlıktaki arama kutusu /blog?q=... ile gelir. Her kelime başlıkta, kategoride, özette ya da
    // öne çıkanlarda geçmelidir; başlıkta geçen kelimeler sonucu üst sıralara taşır.
    var status = document.getElementById('blogSearchStatus');
    var q = (new URLSearchParams(location.search).get('q') || '').trim();
    if (q && status) {
      var words = fold(q).split(/\s+/).filter(function (w) { return w.length > 1; });
      var scored = [];
      cards.forEach(function (card) {
        var title = fold(card.getAttribute('data-title') || '');
        var rest = fold((card.getAttribute('data-cat') || '') + ' ' + (card.getAttribute('data-desc') || ''));
        var score = 0;
        var all = words.length > 0 && words.every(function (w) {
          if (title.indexOf(w) !== -1) { score += 3; return true; }
          if (rest.indexOf(w) !== -1) { score += 1; return true; }
          return false;
        });
        var phrase = fold(q);
        if (all && title.indexOf(phrase) !== -1) score += 5;
        if (all && title.indexOf(phrase) === 0) score += 3;
        if (all && fold(card.getAttribute('data-cat') || '').indexOf(phrase) !== -1) score += 2;
        card.style.display = all ? '' : 'none';
        if (all) scored.push({ card: card, score: score });
      });
      scored.sort(function (a, b) { return b.score - a.score; });
      scored.forEach(function (s) { grid.appendChild(s.card); });
      var shown = scored.length;
      status.textContent = '';
      var text = document.createElement('span');
      text.textContent = '"' + q + '" için ' + shown + ' yazı bulundu. ';
      var clear = document.createElement('a');
      clear.href = '/blog';
      clear.textContent = 'Aramayı temizle';
      status.append(text, clear);
      status.hidden = false;
      document.querySelectorAll('.header-search-input').forEach(function (input) { input.value = q; });
    }

    btns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (status) status.hidden = true;
        // Arama sırasını bırakıp yazıları yeniden en yeniden eskiye diz.
        cards.forEach(function (card) { grid.appendChild(card); });
        btns.forEach(function (b) { b.classList.remove('active'); });
        btn.classList.add('active');
        var filter = btn.getAttribute('data-filter');
        cards.forEach(function (card) {
          var match = filter === 'all' || card.getAttribute('data-cat') === filter;
          card.style.display = match ? '' : 'none';
        });
      });
    });
  });
</script>
</BaseLayout>
