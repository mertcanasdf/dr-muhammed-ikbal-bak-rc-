---
import BaseLayout from '../layouts/BaseLayout.astro';

const events = [
  {
    year: '2026',
    type: 'Etkinlik',
    title: '5. Longevity Show İstanbul',
    description: 'Kişiselleştirilmiş longevity ve genetik yaklaşımları üzerine paylaşımlar.',
  },
  {
    year: '2025',
    type: 'Kongre & Sunum',
    title: 'Uluslararası Medikal Estetik ve Tamamlayıcı Tıp Kongresi',
    description: 'Kollajen stimülasyonu üzerine gerçekleştirilen sunum.',
  },
  {
    year: '2025',
    type: 'Kongre & Sunum',
    title: 'Multidisipliner Çevre ve Kenevir Kongresi',
    description: 'Kanabinoidlerin dermokozmetik kullanımı üzerine gerçekleştirilen sunum.',
  },
];
---
<BaseLayout title="Geçmiş Yıllar — Dr. Muhammed İkbal Bakırcı">
  <style is:global>
    .history-hero { background:var(--main); color:#fff; padding:80px 0 72px; }
    .history-hero__eyebrow { display:block; margin-bottom:12px; color:var(--yellow); font-size:12px; font-weight:700; letter-spacing:1px; text-transform:uppercase; }
    .history-hero__title { max-width:720px; margin-bottom:14px; font-size:clamp(34px,5vw,60px); font-weight:900; line-height:1.05; }
    .history-hero__sub { max-width:620px; color:rgba(255,255,255,.7); font-size:17px; line-height:1.7; }

    .history-section { padding:72px 0 96px; }
    .history-section__intro { max-width:620px; margin-bottom:44px; }
    .history-section__intro h2 { margin-bottom:10px; color:var(--main); font-size:clamp(24px,3vw,34px); font-weight:800; }
    .history-section__intro p { color:var(--gray-500); font-size:16px; line-height:1.7; }

    .history-list { position:relative; display:flex; flex-direction:column; gap:20px; }
    .history-list::before { content:''; position:absolute; top:28px; bottom:28px; left:88px; width:1px; background:var(--border); }
    .history-item { position:relative; display:grid; grid-template-columns:176px 1fr; gap:32px; align-items:start; }
    .history-item__year { position:relative; padding-top:24px; color:var(--blue); font-size:25px; font-weight:900; line-height:1; }
    .history-item__year::after { content:''; position:absolute; top:28px; right:54px; width:9px; height:9px; border:3px solid var(--base); border-radius:50%; background:var(--blue); box-shadow:0 0 0 1px var(--blue); }
    .history-card { padding:24px 28px; border:1px solid var(--border); border-radius:var(--r-lg); background:var(--base); box-shadow:var(--shadow); transition:box-shadow .2s, transform .2s; }
    .history-card:hover { box-shadow:var(--shadow-md); transform:translateY(-2px); }
    .history-card__type { display:block; margin-bottom:8px; color:var(--blue); font-size:11px; font-weight:700; letter-spacing:.7px; text-transform:uppercase; }
    .history-card__title { margin-bottom:8px; color:var(--main); font-size:21px; font-weight:800; line-height:1.3; }
    .history-card__description { color:var(--gray-600); font-size:15px; line-height:1.7; }
    .history-note { margin-top:48px; padding:24px 28px; border-left:4px solid var(--yellow); background:var(--tertiary); }
    .history-note strong { display:block; margin-bottom:4px; color:var(--main); font-size:15px; }
    .history-note p { color:var(--gray-600); font-size:14px; line-height:1.6; }
    @media(max-width:640px){
      .history-hero { padding:56px 0 52px; }
      .history-section { padding:52px 0 72px; }
      .history-list::before { left:16px; }
      .history-item { grid-template-columns:1fr; gap:0; padding-left:40px; }
      .history-item__year { padding-top:0; margin-bottom:10px; font-size:22px; }
      .history-item__year::after { top:3px; left:-28px; right:auto; }
      .history-card { padding:20px; }
      .history-card__title { font-size:18px; }
    }
  </style>

  <section class="history-hero">
    <div class="container">
      <span class="history-hero__eyebrow">Arşiv</span>
      <h1 class="history-hero__title">Geçmiş Yıllar</h1>
      <p class="history-hero__sub">Kongreler, sunumlar ve sağlık alanındaki buluşmalardan bir seçki.</p>
    </div>
  </section>

  <section class="history-section">
    <div class="container">
      <div class="history-section__intro">
        <h2>Etkinlikler ve sunumlar</h2>
        <p>Dr. Muhammed İkbal Bakırcı'nın katıldığı etkinlikleri ve farklı disiplinlerden uzmanlarla gerçekleştirdiği paylaşımları yıllara göre inceleyin.</p>
      </div>

      <div class="history-list">
        {events.map(event => (
          <article class="history-item">
            <div class="history-item__year">{event.year}</div>
            <div class="history-card">
              <span class="history-card__type">{event.type}</span>
              <h3 class="history-card__title">{event.title}</h3>
              <p class="history-card__description">{event.description}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="history-note">
        <strong>Arşiv genişlemeye devam ediyor</strong>
        <p>Yeni etkinlikler ve sunumlar gerçekleştikçe bu sayfada yerini alacak.</p>
      </div>
    </div>
  </section>
</BaseLayout>
