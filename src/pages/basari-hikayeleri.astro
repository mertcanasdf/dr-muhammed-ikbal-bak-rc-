---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Başarı Hikayeleri — Dr. Muhammed İkbal Bakırcı">
  <style is:global>
    .pg-hero{background:var(--main);color:#fff;padding:80px 0;}
    .pg-hero__title{font-size:clamp(32px,5vw,52px);font-weight:900;margin-bottom:16px;}
    .pg-hero__sub{font-size:18px;opacity:.75;max-width:640px;}
    .stories-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;padding:64px 0;}
    @media(max-width:900px){.stories-grid{grid-template-columns:repeat(2,1fr);}}
    @media(max-width:600px){.stories-grid{grid-template-columns:1fr;}}
    .story-card-full{background:var(--base);border-radius:var(--r-lg);overflow:hidden;box-shadow:var(--shadow);transition:transform .2s,box-shadow .2s;cursor:pointer;}
    .story-card-full:hover{transform:translateY(-4px);box-shadow:var(--shadow-md);}
    .story-card-full__img{width:100%;aspect-ratio:4/3;object-fit:cover;}
    .story-card-full__body{padding:20px;}
    .story-card-full__badge{display:inline-block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:#fff;background:var(--green);padding:3px 10px;border-radius:99px;margin-bottom:10px;}
    .story-card-full__title{font-size:17px;font-weight:700;line-height:1.3;margin-bottom:8px;}
    .story-card-full__excerpt{font-size:14px;color:var(--gray-500);line-height:1.6;margin-bottom:12px;}
    .story-card-full__author{font-size:13px;font-weight:600;color:var(--main);}
    .story-modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:2000;overflow-y:auto;padding:24px 16px;backdrop-filter:blur(4px);}
    .story-modal.is-open{display:flex;align-items:center;justify-content:center;}
    .story-modal__box{background:#fff;border-radius:var(--r-lg);width:100%;max-width:560px;margin:auto;overflow:hidden;box-shadow:var(--shadow-lg);position:relative;animation:modalEnter 0.25s cubic-bezier(0.16, 1, 0.3, 1);}
    @keyframes modalEnter { from{opacity:0;transform:translateY(16px);} to{opacity:1;transform:translateY(0);} }
    .story-modal__img-wrap{width:100%;aspect-ratio:16/9;overflow:hidden;background:var(--border);}
    .story-modal__img{width:100%;height:100%;object-fit:cover;}
    .story-modal__body{padding:28px;}
    .story-modal__badge{display:inline-block;font-size:10px;font-weight:700;text-transform:uppercase;color:#fff;background:var(--green);padding:3px 10px;border-radius:99px;margin-bottom:12px;letter-spacing:.5px;}
    .story-modal__close{position:absolute;top:16px;right:16px;background:rgba(0,0,0,0.5);border:none;color:#fff;width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:16px;z-index:10;transition:background 0.2s;}
    .story-modal__close:hover{background:rgba(0,0,0,0.8);}
    .story-modal__title{font-family:Georgia, serif;font-size:22px;font-weight:700;line-height:1.3;margin-bottom:8px;color:var(--main);}
    .story-modal__author{font-size:13px;font-weight:600;color:var(--gray-500);margin-bottom:16px;}
    .story-modal__content{font-size:15px;color:var(--gray-700);line-height:1.7;}
  </style>

    <section class="pg-hero"><div class="container"><h1 class="pg-hero__title">İlham Veren Dönüşümler</h1><p class="pg-hero__sub">Danışanlarımızın deneyimlerinden ilham veren hikayeler.</p></div></section>
    <section class="section"><div class="container">
      <div class="stories-grid">
        <div class="story-card-full" onclick="openStory('ayse')">
          <img src="/assets/images/generated/success_weight_loss.png" alt="Başarı hikayesi görseli - Ayşe K." class="story-card-full__img" />
          <div class="story-card-full__body">
            <span class="story-card-full__badge">Hikaye</span>
            <h3 class="story-card-full__title">Beslenme düzenimle birlikte değerlerim iyileşti</h3>
            <p class="story-card-full__excerpt">Dr. Muhammed İkbal'in longevity protokolünü uygulamak metabolik sağlımı ve enerji seviyelerimi tamamen dönüştürdü.</p>
            <p class="story-card-full__author">Ayşe K., 48 — Bursa</p>
          </div>
        </div>
        <div class="story-card-full" onclick="openStory('mehmet')">
          <img src="/assets/images/generated/success_blood_sugar.png" alt="Başarı hikayesi görseli - Mehmet Y." class="story-card-full__img" />
          <div class="story-card-full__body">
            <span class="story-card-full__badge">Hikaye</span>
            <h3 class="story-card-full__title">90 günde kan şekeri değerlerim belirgin iyileşti</h3>
            <p class="story-card-full__excerpt">Aralıklı oruç ve doğru beslenmeyle, doktor takibinde HbA1c değerim önemli ölçüde düştü.</p>
            <p class="story-card-full__author">Mehmet Y., 55 — İstanbul</p>
          </div>
        </div>
        <div class="story-card-full" onclick="openStory('fatma')">
          <img src="/assets/images/generated/success_energy_fit.png" alt="Başarı hikayesi görseli - Fatma Ç." class="story-card-full__img" />
          <div class="story-card-full__body">
            <span class="story-card-full__badge">Hikaye</span>
            <h3 class="story-card-full__title">8 haftada kendimi çok daha enerjik hissediyorum</h3>
            <p class="story-card-full__excerpt">Artık ne yiyeceğimi ve nedenini anlıyorum. İçerikler bilimsel ve uygulaması çok kolay.</p>
            <p class="story-card-full__author">Fatma Ç., 41 — Ankara</p>
          </div>
        </div>
        <div class="story-card-full" onclick="openStory('kemal')">
          <img src="/assets/images/generated/success_chronic_fatigue.png" alt="Başarı hikayesi görseli - Kemal Ş." class="story-card-full__img" />
          <div class="story-card-full__body">
            <span class="story-card-full__badge">Hikaye</span>
            <h3 class="story-card-full__title">6 ayda yorgunluğumda büyük azalma hissettim</h3>
            <p class="story-card-full__excerpt">Beslenme rehberini uygulamak enerjimi baştan aşağı değiştirdi. 52'mde 30'lumdaki gibi hissediyorum.</p>
            <p class="story-card-full__author">Kemal Ş., 52 — İzmir</p>
          </div>
        </div>
        <div class="story-card-full" onclick="openStory('leyla')">
          <img src="/assets/images/generated/success_thyroid_diet.png" alt="Başarı hikayesi görseli - Leyla A." class="story-card-full__img" />
          <div class="story-card-full__body">
            <span class="story-card-full__badge">Hikaye</span>
            <h3 class="story-card-full__title">Beslenme değişikliği tiroid sürecime iyi geldi</h3>
            <p class="story-card-full__excerpt">Yıllarca süren tiroid sorunlarımın ardından, Dr. Muhammed İkbal'in önerdiği diyet değişiklikleri büyük fark yarattı.</p>
            <p class="story-card-full__author">Leyla A., 45 — Bursa</p>
          </div>
        </div>
        <div class="story-card-full" onclick="openStory('hasan')">
          <img src="/assets/images/generated/success_insulin_resistance.png" alt="Başarı hikayesi görseli - Hasan D." class="story-card-full__img" />
          <div class="story-card-full__body">
            <span class="story-card-full__badge">Hikaye</span>
            <h3 class="story-card-full__title">İnsülin direnci sürecimde büyük yol aldım</h3>
            <p class="story-card-full__excerpt">3 ayda ölçümlerimde belirgin iyileşme oldu; kendimi çok daha enerjik hissediyorum.</p>
            <p class="story-card-full__author">Hasan D., 44 — Ankara</p>
          </div>
        </div>
      </div>
    </div></section>

  <!-- STORY MODAL -->
  <div class="story-modal" id="storyModal" role="dialog" aria-modal="true">
    <div class="story-modal__box">
      <button class="story-modal__close" onclick="closeStory()" aria-label="Kapat">&#10005;</button>
      <div class="story-modal__img-wrap">
        <img id="modalStoryImg" src="" alt="" class="story-modal__img" />
      </div>
      <div class="story-modal__body">
        <span class="story-modal__badge">HİKAYE</span>
        <h2 class="story-modal__title" id="modalStoryTitle"></h2>
        <p class="story-modal__author" id="modalStoryAuthor"></p>
        <div class="story-modal__content" id="modalStoryContent"></div>
      </div>
    </div>
  </div>

  <script is:inline>
    const STORIES_DATA = {
      ayse: {
        title: "Beslenme düzenimle birlikte değerlerim iyileşti",
        author: "Ayşe K., 48 — Bursa",
        img: "/assets/images/generated/success_weight_loss.png",
        content: "Yıllardır kilo verme mücadelemi ve yüksek açlık kan şekerimi kontrol altına almak için her yolu denemiştim. Dr. Muhammed İkbal'in longevity ve ketojenik beslenme protokolü hayatımı tamamen değiştirdi. Kilo verme sürecimle birlikte doktorumun takibinde değerlerim belirgin şekilde iyileşti. Şimdi her zamankinden daha enerjik ve sağlıklıyım."
      },
      mehmet: {
        title: "90 günde kan şekeri değerlerim belirgin iyileşti",
        author: "Mehmet Y., 55 — İstanbul",
        img: "/assets/images/generated/success_blood_sugar.png",
        content: "Tip 2 diyabet teşhisiyle ilaç kullanmaya başlamıştım. Dr. Muhammed İkbal'in aralıklı oruç ve düşük glisemik indeksli beslenme programını harfiyen uyguladım. 90 günün sonunda yapılan tahlillerde, doktorumun takibinde kan şekeri değerlerim önemli ölçüde iyileşti. Vücudun kendini onarma gücünü bizzat yaşadım."
      },
      fatma: {
        title: "8 haftada kendimi çok daha enerjik hissediyorum",
        author: "Fatma Ç., 41 — Ankara",
        img: "/assets/images/generated/success_energy_fit.png",
        content: "Metabolizmamın tamamen durduğunu hissettiğim bir dönemde Dr. Muhammed İkbal'in bilimsel içerikleri ve beslenme rehberiyle tanıştım. 8 hafta içinde aç kalmadan, beslenme düzenimi iyileştirerek kilo verdim. En büyük kazanımım ise gün içindeki o sürekli yorgunluğumun yerini bitmek bilmeyen bir hayat enerjisinin alması oldu."
      },
      kemal: {
        title: "6 ayda yorgunluğumda büyük azalma hissettim",
        author: "Kemal Ş., 52 — İzmir",
        img: "/assets/images/generated/success_chronic_fatigue.png",
        content: "Sabah yataktan kalkmak benim için tam bir işkenceydi. Kronik yorgunluk sendromu ile yaşamaktan bezmiştim. Sitenizdeki uyku optimizasyonu ve anti-inflamatuar beslenme rehberlerini 6 ay boyunca düzenli uyguladım. Bugün 52 yaşındayım ve kendimi 30'lu yaşlarımdaki kadar aktif, dinç ve zinde hissediyorum."
      },
      leyla: {
        title: "Beslenme değişikliği tiroid sürecime iyi geldi",
        author: "Leyla A., 45 — Bursa",
        img: "/assets/images/generated/success_thyroid_diet.png",
        content: "Haşimato tiroidi hastası olarak yıllarca kronik ödem, yorgunluk ve saç dökülmesiyle savaştım. Dr. Muhammed İkbal'in glütensiz, temiz beslenme ve tiroid koruma protokolünü hayatıma entegre ettim. Doktor takibinde tiroid değerlerimde iyileşme gözlendi ve kendimi çok daha iyi hissediyorum."
      },
      hasan: {
        title: "İnsülin direnci sürecimde büyük yol aldım",
        author: "Hasan D., 44 — Ankara",
        img: "/assets/images/generated/success_insulin_resistance.png",
        content: "Aşırı göbek bölgesi yağlanması ve yemeklerden sonra gelen ani uyku basmaları beni çok yoruyordu. Yapılan ölçümlerde insülin direncim çok yüksek çıktı. Dr. Muhammed İkbal'in önerdiği Bölge 2 egzersizleri ve karbonhidrat kısıtlaması protokolü sayesinde 3 ayın sonunda ölçümlerimde belirgin iyileşme oldu; gün içi enerjim arttı."
      }
    };

    function openStory(id) {
      const data = STORIES_DATA[id];
      if (!data) return;
      document.getElementById('modalStoryImg').src = data.img;
      document.getElementById('modalStoryImg').alt = data.title;
      document.getElementById('modalStoryTitle').textContent = data.title;
      document.getElementById('modalStoryAuthor').textContent = data.author;
      document.getElementById('modalStoryContent').textContent = data.content;
      const modal = document.getElementById('storyModal');
      modal.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }

    function closeStory() {
      const modal = document.getElementById('storyModal');
      modal.classList.remove('is-open');
      document.body.style.overflow = '';
    }

    document.getElementById('storyModal').addEventListener('click', (e) => {
      if (e.target.id === 'storyModal') {
        closeStory();
      }
    });
  </script>
</BaseLayout>
