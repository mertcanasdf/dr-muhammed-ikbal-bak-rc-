  <!-- FILTER JAVASCRIPT -->
  <script is:inline>
    function filterCategory(btn, category) {
      // Manage active states of main tabs
      document.querySelectorAll('.me-tab').forEach(function(t) {
        t.classList.remove('is-active');
        t.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('is-active');
      btn.setAttribute('aria-selected', 'true');

      // Manage subtabs visibility
      const subTabsWrapper = document.getElementById('sub-tabs-wrapper');
      if (category === 'uygulamalar') {
        subTabsWrapper.style.display = 'block';
        // Reset sub-tabs selection to 'all-apps'
        subTabsWrapper.querySelectorAll('.me-sub-tab').forEach(function(st) {
          st.classList.remove('is-active');
          st.setAttribute('aria-selected', 'false');
        });
        const allAppsSubTab = subTabsWrapper.querySelector('.me-sub-tab[onclick*="all-apps"]');
        if (allAppsSubTab) {
          allAppsSubTab.classList.add('is-active');
          allAppsSubTab.setAttribute('aria-selected', 'true');
        }
      } else {
        subTabsWrapper.style.display = 'none';
      }

      // Filter sections and cards
      const sections = document.querySelectorAll('.estetik-section');
      sections.forEach(function(section) {
        const sectionSec = section.getAttribute('data-section');
        if (category === 'all' || sectionSec === category) {
          section.style.display = 'block';
          // Within visible sections, show all cards
          section.querySelectorAll('.estetik-card').forEach(function(card) {
            card.classList.remove('is-hidden');
          });
        } else {
          section.style.display = 'none';
        }
      });
    }

    function filterSubCategory(btn, subcat) {
      // Manage active states of sub-tabs
      const container = btn.closest('.me-sub-tabs-container');
      container.querySelectorAll('.me-sub-tab').forEach(function(t) {
        t.classList.remove('is-active');
        t.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('is-active');
      btn.setAttribute('aria-selected', 'true');

      // Filter cards inside the 'uygulamalar' section
      const sections = document.querySelectorAll('.estetik-section');
      sections.forEach(function(section) {
        const sectionSec = section.getAttribute('data-section');
        if (sectionSec === 'uygulamalar') {
          section.style.display = 'block';
          section.querySelectorAll('.estetik-card').forEach(function(card) {
            const cardCats = card.getAttribute('data-category') ? card.getAttribute('data-category').split(' ') : [];
            if (subcat === 'all-apps' || cardCats.includes(subcat)) {
              card.classList.remove('is-hidden');
            } else {
              card.classList.add('is-hidden');
            }
          });
        } else {
          section.style.display = 'none';
        }
      });
    }

    // Parse URL parameters for routing tabs
    document.addEventListener('astro:page-load', () => {
      const urlParams = new URLSearchParams(window.location.search);
      const tabParam = urlParams.get('tab');
      const subParam = urlParams.get('sub');

      if (tabParam) {
        const tabBtn = document.querySelector(`.me-tab[onclick*="'${tabParam}'"]`);
        if (tabBtn) {
          tabBtn.click();
        }
      } else {
        // Fallback default on load: click the 'Tümü' (all) tab to trigger correct state
        const defaultTab = document.querySelector(`.me-tab[onclick*="'all'"]`);
        if (defaultTab) {
          defaultTab.click();
        }
      }

      if (subParam && tabParam === 'uygulamalar') {
        setTimeout(() => {
          const subTabBtn = document.querySelector(`.me-sub-tab[onclick*="'${subParam}'"]`);
          if (subTabBtn) {
            subTabBtn.click();
            const container = document.querySelector('.me-sub-tabs-container');
            if (container) {
              container.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
          }
        }, 100);
      }
    });
  </script>
