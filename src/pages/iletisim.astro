---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="İletişim — Dr. Muhammed İkbal Bakırcı">
  <style is:global>
    .contact-hero { background:var(--main); color:#fff; padding:80px 0; }
    .contact-hero__title { font-size:clamp(32px,5vw,52px); font-weight:900; margin-bottom:12px; }
    .contact-hero__sub { font-size:18px; opacity:.75; }
    .contact-form-wrap { max-width:600px; margin:0 auto; padding:80px 0; }
    @media(max-width:768px){ .contact-form-wrap{ padding:48px 0; } }
    .contact-form { background:var(--base); border-radius:var(--r-lg); padding:40px; box-shadow:var(--shadow-md); }
    .contact-form h2 { font-size:24px; font-weight:800; margin-bottom:24px; }
    .form-group { margin-bottom:20px; }
    .form-group label { display:block; font-size:14px; font-weight:600; margin-bottom:6px; color:var(--gray-700); }
    .form-group input, .form-group select, .form-group textarea {
      width:100%; padding:12px 16px; border:1.5px solid var(--border);
      border-radius:var(--r); font-family:var(--font); font-size:15px;
      color:var(--main); background:var(--base); outline:none;
      transition:border-color 0.15s;
    }
    .form-group input:focus, .form-group select:focus, .form-group textarea:focus { border-color:var(--main); }
    .form-group textarea { min-height:140px; resize:vertical; }
  </style>

    <section class="contact-hero">
      <div class="container">
        <h1 class="contact-hero__title">İletişim</h1>
        <p class="contact-hero__sub">Sorularınız, iş birlikleri veya medya talepleriniz için bize ulaşın.</p>
      </div>
    </section>

    <div class="container">
      <div class="contact-form-wrap">
        <div class="contact-form">
          <h2>Mesaj Gönderin</h2>
          <form>
            <div class="form-group"><label for="name">Ad Soyad</label><input type="text" id="name" placeholder="Adınız ve soyadınız" /></div>
            <div class="form-group"><label for="email">E-posta</label><input type="email" id="email" placeholder="eposta@ornek.com" /></div>
            <div class="form-group">
              <label for="topic">Konu</label>
              <select id="topic">
                <option value="">Konu seçin...</option>
                <option>Genel Bilgi</option>
                <option>Medya &amp; Basın</option>
                <option>İş Birliği</option>
                <option>Teknik Destek</option>
              </select>
            </div>
            <div class="form-group"><label for="message">Mesajınız</label><textarea id="message" placeholder="Mesajınızı buraya yazın..."></textarea></div>
            <button type="submit" class="btn btn-dark" style="width:100%">Gönder</button>
          </form>
        </div>
      </div>
    </div>
</BaseLayout>
