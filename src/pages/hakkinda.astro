---
import BaseLayout from '../layouts/BaseLayout.astro';
import Timeline, { type TimelineItem } from '../components/Timeline.astro';

// Kaynak: Medical Park doktor profili + bu sayfanın biyografi metni (docs/arastirma/2026-10-05-mesleki-ozgecmis.md).
const career: TimelineItem[] = [
  { year: '2001–2008', type: 'Eğitim', title: 'Atatürk Üniversitesi Tıp Fakültesi', description: 'Tıp eğitimini 2008 yılında tamamladı.' },
  { year: '2009–2018', type: 'Klinik deneyim', title: 'Kamu ve özel hastanelerde hekimlik', description: 'Doğu Anadolu’da başlayan klinik pratiğini Bursa’da kamu ve özel hastanelerde sürdürdü.' },
  { year: '2012–2013', type: 'Acil tıp', title: 'Hava ambulans hekimi', description: 'Gökçen Havacılık Acil Sağlık Hizmetleri bünyesinde görev aldı.' },
  { year: '2018–2019', type: 'Sağlık yönetimi', title: 'Başhekim Yardımcısı', description: 'Bursa Prof. Dr. Türkan Akyol Göğüs Hastalıkları Hastanesi.' },
  { year: '2019–2022', type: 'Sağlık yönetimi', title: 'Başhekim Yardımcısı', description: 'Bursa Şehir Hastanesi; hastanenin kuruluş sürecinde görev aldı.' },
  { year: '2022–', type: 'Sağlık yönetimi', title: 'Başhekim', description: 'VM Medical Park Bursa Hastanesi. Medikal estetik uygulamalarını da sürdürüyor.' },
];
---
<BaseLayout title="Hakkında — Dr. Muhammed İkbal Bakırcı" pageType="AboutPage">
  <style is:global>
    .about-hero { background: var(--main); color: #fff; padding: 80px 0; }
    .about-hero__title { font-size: clamp(32px,5vw,56px); font-weight:900; margin-bottom:8px; }
    .about-hero__role { font-size:17px; opacity:.8; font-weight:500; margin-bottom:4px; }
    .about-hero__sub { font-size:14px; opacity:.6; }

    .about-grid { display:grid; grid-template-columns:320px 1fr; gap:64px; padding:80px 0; align-items:start; }
    @media(max-width:900px){ .about-grid{ grid-template-columns:1fr; gap:40px; padding:48px 0; } }

    .about-img { width:100%; height:auto; display:block; border-radius:16px; aspect-ratio:2/3; object-fit:cover; object-position:center top; }

    .about-content h2 { font-size:13px; font-weight:700; text-transform:uppercase; letter-spacing:.8px; color:var(--blue); margin-bottom:20px; }
    .about-content p { font-size:16px; line-height:1.9; color:#1a1a1a; margin-bottom:20px; }

    .about-history-link-wrap { display:flex; align-items:center; justify-content:space-between; gap:28px; margin-top:36px; padding-top:28px; border-top:1px solid var(--border); }
    .about-history-link-copy { max-width:480px; }
    .about-history-link-eyebrow { display:block; margin-bottom:6px; color:var(--blue); font-size: 12px; font-weight:700; letter-spacing:.7px; text-transform:uppercase; }
    .about-history-link-title { margin-bottom:6px; font-size:22px; font-weight:800; line-height:1.25; }
    .about-history-link-copy p { margin:0; color:var(--gray-500); font-size:14px; line-height:1.6; }
    .about-history-link { display:inline-flex; flex-shrink:0; align-items:center; justify-content:center; padding:12px 20px; border:2px solid var(--main); border-radius:var(--r-btn); background:var(--main); color:#fff; font-size:14px; font-weight:700; transition:background .2s, border-color .2s, transform .2s; }
    .about-history-link:hover { border-color:var(--blue); background:var(--blue); transform:translateY(-2px); }
    @media(max-width:560px){ .about-history-link-wrap{ align-items:flex-start; flex-direction:column; gap:18px; } }

  </style>

  <section class="about-hero">
    <div class="container">
      <h1 class="about-hero__title">Dr. Muhammed İkbal Bakırcı</h1>
      <p class="about-hero__role">Başhekim &amp; Medikal Estetik Uygulamaları</p>
      <p class="about-hero__sub">VM Medical Park Bursa Hastanesi Başhekimi</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="about-grid">

        <div>
          <img src="/assets/images/generated/doctor-portrait.webp" alt="Dr. Muhammed İkbal Bakırcı" class="about-img" />
        </div>

        <div class="about-content">
          <h2>Hakkımda</h2>

          <p>Dr. Muhammed İkbal Bakırcı, 2008 yılında Atatürk Üniversitesi Tıp Fakültesi'nden mezun olmuştur. Mezuniyetinin ardından Doğu Anadolu'da hekimlik yaparak klinik pratiğe başlamış; Gökçen Havacılık bünyesinde hava ambulans hekimi olarak görev alarak acil tıp deneyimini derinleştirmiştir. Bu süreçten sonra Bursa'ya yerleşmiş, kamu ve özel hastanelerde klinik çalışmalarını sürdürmüştür.</p>

          <p>Yöneticilik kariyeri Bursa'da şekillenmiştir. Prof. Dr. Türkan Akyol Göğüs Hastalıkları Hastanesi ve ardından Bursa Şehir Hastanesi'nin kuruluş sürecinde başhekim yardımcısı olarak görev almıştır. 2022 yılından bu yana Bursa VM Medikalpark Hastanesi'nde Başhekim olarak görevini sürdürmekte; aynı zamanda medikal estetik uygulamalarını aktif olarak yürütmektedir.</p>

          <p>Sağlık Bakanlığı onaylı Estetik ve Kozmetik Uygulamaları Sertifikası'na sahip olan Dr. Muhammed İkbal Bakırcı; botulinum toksin, dermal dolgu, mezoterapi ve PRP gibi medikal estetik uygulamaları kişiye özel değerlendirmeyle planlamaktadır. Skin longevity alanında kollajen korunumu, inflamasyon kontrolü ve uzun vadeli cilt kalitesi üzerine çalışmakta; doğal ve sürdürülebilir sonuçları öncelikli hedef olarak benimsemektedir.</p>

          <p>Ulusal ve uluslararası kongrelerde konuşmacı olarak yer almaktadır. 2025 yılında Multidisipliner Çevre ve Kenevir Kongresi'nde kanabinoidlerin dermokozmetik kullanımı, Uluslararası Medikal Estetik ve Tamamlayıcı Tıp Kongresi'nde kollajen stimülasyonu üzerine sunum gerçekleştirmiştir. 2026 yılında 5. Longevity Show İstanbul'da kişiselleştirilmiş longevity ve genetik konusunda yer almıştır. İstinye Üniversitesi Sosyal Bilimler Enstitüsü'nde uluslararası pazarlama alanında doktora çalışmalarını sürdürmektedir. 2024 yılından bu yana ATİK Uluslararası Ticaret ve İşbirliği Konseyi Bursa İl Başkanıdır; Türkiye Atletizm Federasyonu'nda yönetim kurulu üyeliği yapmıştır.</p>

          <div class="about-history-link-wrap">
            <div class="about-history-link-copy">
              <span class="about-history-link-eyebrow">Kongreler · Sunumlar · Buluşmalar</span>
              <h3 class="about-history-link-title">Geçmiş Yıllar</h3>
              <p>Katıldığımız etkinlikleri, kongreleri ve gerçekleştirilen sunumları yıllara göre keşfedin.</p>
            </div>
            <a class="about-history-link" href="/gecmis-yillar">Geçmiş Yıllar</a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <section class="section about-journey" aria-labelledby="journey-title">
    <div class="container">
      <div class="about-journey__intro">
        <h2 id="journey-title">Mesleki Yolculuk</h2>
        <p>Hekimlikten sağlık yönetimine uzanan kariyer adımları.</p>
      </div>
      <Timeline items={career} />
    </div>
  </section>
</BaseLayout>

<style>
  .about-journey { padding: 24px 0 96px; }
  .about-journey__intro { max-width: 620px; margin-bottom: 40px; }
  .about-journey__intro h2 { margin-bottom: 10px; font-size: clamp(24px, 3vw, 34px); font-weight: 800; color: var(--main); }
  .about-journey__intro p { color: var(--gray-500); font-size: 16px; line-height: 1.7; }
  @media (max-width: 640px) { .about-journey { padding: 8px 0 64px; } }
</style>
