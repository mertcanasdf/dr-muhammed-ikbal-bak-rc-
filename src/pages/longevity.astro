                  </svg>
                </span>
                <span class="pillar-trigger__title">{area.title}</span>
              </span>
              <svg class="pillar-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
