---
// src/layouts/BaseLayout.astro
import { ViewTransitions } from 'astro:transitions';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {
  DEFAULT_IMAGE,
  getAbsoluteUrl,
  getCanonicalUrl,
  getPageDescription,
  buildSiteStructuredData,
} from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  structuredData?: Record<string, unknown>;
  includeSplide?: boolean;
  includeArticleTabs?: boolean;
}

const {
  title,
  description: providedDescription,
  image = DEFAULT_IMAGE,
  type = 'website',
  structuredData,
  includeSplide = false,
  includeArticleTabs = false,
} = Astro.props;
const description = getPageDescription(Astro.url.pathname, providedDescription);
const canonicalUrl = getCanonicalUrl(Astro.url.pathname);
const absoluteImage = getAbsoluteUrl(image);
const siteStructuredData = buildSiteStructuredData({
  pathname: Astro.url.pathname,
  title,
  description,
  image,
});
const jsonLd = JSON.stringify(
  structuredData
    ? [siteStructuredData, structuredData]
    : siteStructuredData,
).replace(/</g, '\\u003c');
---
<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="index, follow" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0c0f0d" />
  <title>{title}</title>
  <link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" hreflang="tr" href={canonicalUrl} />
  <meta property="og:type" content={type} />
  <meta property="og:locale" content="tr_TR" />
  <meta property="og:site_name" content="Dr. Muhammed İkbal Bakırcı" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={absoluteImage} />
  <meta property="og:image:alt" content={title} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={absoluteImage} />
  <script type="application/ld+json" set:html={jsonLd}></script>
  <link rel="preload" href="/assets/fonts/roboto/roboto-400.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/assets/fonts/roboto/roboto-700.woff2" as="font" type="font/woff2" crossorigin />
  {includeSplide && <link rel="stylesheet" href="/assets/vendor/splide.min.css" />}
  {includeSplide && <script src="/assets/vendor/splide.min.js" defer></script>}
  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="/mobile-menu.css" />
  {includeArticleTabs && <link rel="stylesheet" href="/mobile-article-tabs.css" />}
  <ViewTransitions />
</head>
<body>
  <AnnouncementBar />
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
  <script src="/script.js" defer></script>
  <script src="/mobile-menu.js" defer></script>
</body>
</html>
