---
// src/components/AnnouncementBar.astro
---
<div class="announcement-bar" id="announcementBar">
  <div class="container announcement-bar__inner">
    <p id="announcementText"></p>
    <button class="announcement-bar__close" id="closeAnnouncement" aria-label="Kapat">&#10005;</button>
  </div>
</div>

<script is:inline>
  function initAnnouncementBar() {
    var messages = [
      '#1 sağlık engelinizi 2 dakikada keşfedin → <a href="/quizler">Hemen Başla</a>',
      'Ücretsiz sağlık rehberlerini indirin → <a href="/rehberler">Rehberler</a>',
      'Medikal estetik ve cilt gençleşmesi hakkında uzman içerikleri → <a href="/medikal-estetik">Keşfet</a>',
      'Birebir söyleşi için WhatsApp\'tan randevu alın → <a href="https://wa.me/905442244813">Ulaşın</a>',
      'Longevity ve hücresel sağlık üzerine podcast bölümleri → <a href="/podcast">Dinle</a>'
    ];
    var idx = 0;
    var el = document.getElementById('announcementText');
    var bar = document.getElementById('announcementBar');
    var closeBtn = document.getElementById('closeAnnouncement');
    if (!el || !bar) return;
    if (window._announcementInterval) clearInterval(window._announcementInterval);
    el.style.opacity = '1';
    el.innerHTML = messages[0];
    window._announcementInterval = setInterval(function() {
      el.style.opacity = '0';
      setTimeout(function() {
        idx = (idx + 1) % messages.length;
        el.innerHTML = messages[idx];
        el.style.opacity = '1';
      }, 300);
    }, 4000);
    if (closeBtn) {
      closeBtn.addEventListener('click', function() {
        bar.style.display = 'none';
        clearInterval(window._announcementInterval);
      });
    }
  }
  document.addEventListener('astro:page-load', initAnnouncementBar);
</script>
