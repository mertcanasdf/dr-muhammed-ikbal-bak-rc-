---
// Yıllara göre dikey zaman çizelgesi. Geçmiş Yıllar (etkinlikler) ve Hakkında (mesleki yolculuk) kullanır.
export interface TimelineItem {
  year: string;
  type: string;
  title: string;
  description: string;
  href?: string;
  linkLabel?: string;
}

interface Props {
  items: TimelineItem[];
}

const { items } = Astro.props;
---
<ol class="timeline">
  {items.map((item) => (
    <li class="timeline__item">
      <div class="timeline__year">{item.year}</div>
      <div class="timeline__card">
        <span class="timeline__type">{item.type}</span>
        <h3 class="timeline__title">{item.title}</h3>
        <p class="timeline__description">{item.description}</p>
        {item.href && (
          <a class="timeline__link" href={item.href} target="_blank" rel="noopener">{item.linkLabel ?? 'Kaynağı görüntüleyin'} &rarr;</a>
        )}
      </div>
    </li>
  ))}
</ol>

<style>
  .timeline { position: relative; display: flex; flex-direction: column; gap: 20px; list-style: none; padding: 0; }
  .timeline::before { content: ''; position: absolute; top: 28px; bottom: 28px; left: 88px; width: 1px; background: var(--border); }
  .timeline__item { position: relative; display: grid; grid-template-columns: 176px 1fr; gap: 32px; align-items: start; }
  .timeline__year { position: relative; padding-top: 24px; color: var(--blue); font-size: 22px; font-weight: 900; line-height: 1.1; }
  .timeline__year::after { content: ''; position: absolute; top: 28px; right: 54px; width: 9px; height: 9px; border: 3px solid var(--base); border-radius: 50%; background: var(--blue); box-shadow: 0 0 0 1px var(--blue); }
  .timeline__card { padding: 24px 28px; border: 1px solid var(--border); border-radius: var(--r-lg); background: var(--base); box-shadow: var(--shadow); transition: box-shadow .2s, transform .2s; }
  .timeline__card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
  .timeline__type { display: block; margin-bottom: 8px; color: var(--blue); font-size: 11px; font-weight: 700; letter-spacing: .7px; text-transform: uppercase; }
  .timeline__title { margin-bottom: 8px; color: var(--main); font-size: 20px; font-weight: 800; line-height: 1.3; }
  .timeline__description { color: var(--gray-700); font-size: 15px; line-height: 1.7; }
  .timeline__link { display: inline-block; margin-top: 12px; color: var(--blue); font-size: 14px; font-weight: 700; }
  .timeline__link:hover { text-decoration: underline; }
  @media (max-width: 640px) {
    .timeline::before { left: 16px; }
    .timeline__item { grid-template-columns: 1fr; gap: 0; padding-left: 40px; }
    .timeline__year { padding-top: 0; margin-bottom: 10px; font-size: 20px; }
    .timeline__year::after { top: 3px; left: -28px; right: auto; }
    .timeline__card { padding: 20px; }
    .timeline__title { font-size: 18px; }
  }
</style>
