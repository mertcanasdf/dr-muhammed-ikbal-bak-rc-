<BaseLayout title="Dr. Muhammed İkbal Bakırcı — Longevity &amp; Sağlık Eğitimi" includeSplide={true}>

    <!-- HERO -->
    <section class="hero">
      <div class="hero__left">
        <p class="hero__name">Dr. Muhammed İkbal</p>
        <h1 class="hero__title" id="heroTitle">Düşünceleriniz görünmez olabilir. Ama bedeniniz onları gerçekmiş gibi yaşar.</h1>
        <p class="hero__quote">"Doğru bilgiyle uzun yıllar daha sağlıklı ve enerjik yaşayabilirsiniz."</p>
        <a href="https://wa.me/905442244813?text=Merhaba%2C%20sizinle%20ileti%C5%9Fime%20ge%C3%A7mek%20istiyorum." target="_blank" rel="noopener" class="btn btn-light hero__cta">Hemen İletişime Geç</a>
      </div>
      <div class="hero__right" aria-hidden="true"></div>
    </section>

    <script is:inline>
      function initHeroRotation() {
        var headlines = [
          'Düşünceleriniz görünmez olabilir. Ama bedeniniz onları gerçekmiş gibi yaşar.',
          'Bir düşünce yalnızca zihinde kalmaz. Saniyeler içinde hormonlara, sinir sistemine ve biyolojinize dönüşür.',
          'Beyin doğruları değil, tekrarları öğrenir. En çok kullandığınız yolu otoyola dönüştürür.',
          'Bedeniniz, kendinizi kim sandığınıza inanır.',
          'Hücreleriniz, kim olduğunuzu düşündüğünüz kişiye göre davranmayı öğrenir.'
        ];
        var idx = 0; // ilk metin HTML'de statik, rotasyon 2. metinden başlar
        var el = document.getElementById('heroTitle');
        if (!el) return;
        if (window._heroInterval) clearInterval(window._heroInterval);
        window._heroInterval = setInterval(function() {
          el.style.opacity = '0';
          setTimeout(function() {
            idx = (idx + 1) % headlines.length;
            el.textContent = headlines[idx];
            el.style.opacity = '1';
          }, 500);
        }, 6000);
      }
      document.addEventListener('astro:page-load', initHeroRotation);
    </script>

