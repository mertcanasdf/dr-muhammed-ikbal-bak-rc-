---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Quizler — Dr. Muhammed İkbal Bakırcı">
  <style is:global>
    .pg-hero{background:var(--main);color:#fff;padding:80px 0;}
    .pg-hero__tag{font-size:12px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--yellow);margin-bottom:12px;}
    .pg-hero__title{font-size:clamp(32px,5vw,52px);font-weight:900;margin-bottom:16px;line-height:1.1;}
    .pg-hero__sub{font-size:18px;opacity:.75;max-width:640px;margin-bottom:32px;}
    .quiz-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:28px;padding:40px 0 64px;}
    @media(max-width:700px){.quiz-grid{grid-template-columns:1fr;}}
    .quiz-card{background:var(--base);border-radius:var(--r-lg);overflow:hidden;box-shadow:var(--shadow);transition:transform .2s,box-shadow .2s;}
    .quiz-card:hover{transform:translateY(-2px);box-shadow:var(--shadow-md);}
    .quiz-card__img{width:100%;aspect-ratio:16/9;object-fit:cover;}
    .quiz-card__body{padding:24px;}
    .quiz-card__tag{display:inline-block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:#fff;background:var(--green);padding:3px 10px;border-radius:99px;margin-bottom:14px;}
    .quiz-card__title{font-size:19px;font-weight:800;margin-bottom:8px;}
    .quiz-card__desc{font-size:14px;color:var(--gray-500);line-height:1.6;margin-bottom:14px;}
    .quiz-card__meta{display:flex;gap:16px;font-size:12px;color:var(--gray-500);margin-bottom:18px;}
    .quiz-modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:2000;overflow-y:auto;padding:24px 16px;}
    .quiz-modal.is-open{display:flex;align-items:flex-start;justify-content:center;}
    .quiz-modal__box{background:#fff;border-radius:var(--r-lg);width:100%;max-width:640px;margin:auto;overflow:hidden;}
    .quiz-modal__head{background:var(--main);color:#fff;padding:28px 32px 24px;}
    .quiz-modal__head-title{font-size:22px;font-weight:900;margin-bottom:4px;}
    .quiz-modal__progress-bar{height:4px;background:rgba(255,255,255,.2);border-radius:2px;margin-top:16px;overflow:hidden;}
    .quiz-modal__progress-fill{height:100%;background:var(--green);border-radius:2px;transition:width .35s;}
    .quiz-modal__body{padding:32px;}
    .quiz-modal__close{position:absolute;top:16px;right:20px;background:none;border:none;color:#fff;font-size:24px;cursor:pointer;line-height:1;}
    .quiz-modal__head{position:relative;}
    .q-step{display:none;}
    .q-step.is-active{display:block;}
    .q-number{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:var(--green);margin-bottom:8px;}
    .q-text{font-size:18px;font-weight:700;line-height:1.4;margin-bottom:24px;color:var(--main);}
    .q-options{display:flex;flex-direction:column;gap:12px;}
    .q-option{display:flex;align-items:flex-start;gap:14px;padding:14px 18px;border:2px solid var(--border);border-radius:var(--r);cursor:pointer;transition:border-color .15s,background .15s;text-align:left;}
    .q-option:hover{border-color:var(--green);background:#f0faf1;}
    .q-option.selected{border-color:var(--green);background:#f0faf1;}
    .q-option__dot{width:20px;height:20px;border-radius:50%;border:2px solid var(--border);flex-shrink:0;margin-top:1px;display:flex;align-items:center;justify-content:center;transition:border-color .15s,background .15s;}
    .q-option.selected .q-option__dot{border-color:var(--green);background:var(--green);}
    .q-option.selected .q-option__dot::after{content:'';width:8px;height:8px;border-radius:50%;background:#fff;}
    .q-option__label{font-size:15px;line-height:1.5;color:var(--main);}
    .q-nav{display:flex;justify-content:space-between;align-items:center;margin-top:28px;}
    .q-nav__back{background:none;border:none;color:var(--gray-500);font-size:14px;cursor:pointer;padding:8px 0;}
    .q-nav__back:hover{color:var(--main);}
    .q-nav__next{font-size:14px;padding:12px 28px;}
    .q-result{display:none;padding:8px 0 16px;}
    .q-result.is-active{display:block;}
    .q-result__label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.8px;color:#fff;background:var(--green);padding:4px 14px;border-radius:99px;display:inline-block;margin-bottom:16px;}
    .q-result__title{font-size:22px;font-weight:900;margin-bottom:12px;color:var(--main);}
    .q-result__score-bar{background:var(--tertiary);border-radius:99px;height:10px;margin:16px 0;overflow:hidden;}
    .q-result__score-fill{height:100%;background:var(--green);border-radius:99px;transition:width .8s ease;}
    .q-result__desc{font-size:15px;color:var(--gray-700);line-height:1.7;margin-bottom:20px;}
    .q-result__tips{background:var(--tertiary);border-radius:var(--r);padding:20px 24px;margin-bottom:24px;}
    .q-result__tips h4{font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;margin-bottom:12px;color:var(--main);}
    .q-result__tips ul{padding-left:18px;}
    .q-result__tips li{font-size:14px;color:var(--gray-700);line-height:1.9;}
    .q-result__actions{display:flex;gap:12px;flex-wrap:wrap;}
    .q-result__retake{background:none;border:2px solid var(--border);color:var(--main);font-weight:700;font-size:14px;padding:10px 24px;border-radius:var(--r-btn);cursor:pointer;transition:border-color .15s;}
    .q-result__retake:hover{border-color:var(--main);}
  </style>

    <section class="pg-hero"><div class="container">
      <p class="pg-hero__tag">Sağlık Değerlendirmesi</p>
      <h1 class="pg-hero__title">Vücudunuzu 5 Dakikada<br>Tanıyın</h1>
      <p class="pg-hero__sub">Vücut tipinizi, metabolik sağlığınızı ve longevity profilinizi keşfedin. Her test bilimsel kaynaklara dayanır ve 2–5 dakikada tamamlanır.</p>
      <a href="#quizler" class="btn btn-light">Testlere Göz At</a>
    </div></section>

    <section class="section" id="quizler"><div class="container">
      <h2 class="section-title">Ücretsiz Sağlık Testleri</h2>
      <div class="quiz-grid">

        <div class="quiz-card">
          <img src="/assets/images/generated/quiz_body_type.png" alt="Vücut Tipi Quizi" class="quiz-card__img" />
          <div class="quiz-card__body">
            <span class="quiz-card__tag">Ücretsiz</span>
            <h3 class="quiz-card__title">Vücut Tipi Quizi</h3>
            <p class="quiz-card__desc">Dr. Berg'in hormonal vücut tipi modeline dayalı değerlendirme. Adrenal, Tiroid, Karaciğer veya Over tipini keşfedin.</p>
            <div class="quiz-card__meta"><span>12 soru</span><span>~3 dakika</span></div>
            <button class="btn btn-dark" onclick="openQuiz('vucut')">Teste Başla</button>
          </div>
        </div>

        <div class="quiz-card">
          <img src="/assets/images/generated/quiz_longevity_score.png" alt="Longevity Skoru" class="quiz-card__img" />
          <div class="quiz-card__body">
            <span class="quiz-card__tag">Ücretsiz</span>
            <h3 class="quiz-card__title">Longevity Skoru</h3>
            <p class="quiz-card__desc">NOVOS ve DaVinci Labs metodolojisine dayalı biyolojik yaş değerlendirmesi. 15 yaşam tarzı faktörü üzerinden skorunuzu ölçün.</p>
            <div class="quiz-card__meta"><span>15 soru</span><span>~4 dakika</span></div>
            <button class="btn btn-dark" onclick="openQuiz('longevity')">Teste Başla</button>
          </div>
        </div>

        <div class="quiz-card">
          <img src="/assets/images/generated/quiz_gut_health.png" alt="Bağırsak Sağlığı" class="quiz-card__img" />
          <div class="quiz-card__body">
            <span class="quiz-card__tag">Ücretsiz</span>
            <h3 class="quiz-card__title">Bağırsak Sağlığı Testi</h3>
            <p class="quiz-card__desc">The Gut Health Doctor metodolojisine dayalı değerlendirme. Mikrobiyom sağlığınızı etkileyen yaşam tarzı faktörlerini ölçün.</p>
            <div class="quiz-card__meta"><span>14 soru</span><span>~3 dakika</span></div>
            <button class="btn btn-dark" onclick="openQuiz('bagırsak')">Teste Başla</button>
          </div>
        </div>

        <div class="quiz-card">
          <img src="/assets/images/generated/quiz_stress_cortisol.png" alt="Stres ve Kortizol" class="quiz-card__img" />
          <div class="quiz-card__body">
            <span class="quiz-card__tag">Ücretsiz</span>
            <h3 class="quiz-card__title">Stres ve Kortizol Profili</h3>
            <p class="quiz-card__desc">Women's Health Network adrenal değerlendirmesinden uyarlanan test. Kortizol yükünüzü ve adrenal sağlığınızı ölçün.</p>
            <div class="quiz-card__meta"><span>16 soru</span><span>~4 dakika</span></div>
            <button class="btn btn-dark" onclick="openQuiz('stres')">Teste Başla</button>
          </div>
        </div>

        <div class="quiz-card">
          <img src="/assets/images/generated/quiz_inflammation.png" alt="Enflamasyon ve Otoimmünite" class="quiz-card__img" />
          <div class="quiz-card__body">
            <span class="quiz-card__tag">Ücretsiz</span>
            <h3 class="quiz-card__title">Enflamasyon & Otoimmünite Riski</h3>
            <p class="quiz-card__desc">Sistemik enflamasyon ve otoimmünite risk düzeyinizi ölçün. Beslenme, eklem ve bağırsak hassasiyeti belirteçleri.</p>
            <div class="quiz-card__meta"><span>8 soru</span><span>~2 dakika</span></div>
            <button class="btn btn-dark" onclick="openQuiz('enflamasyon')">Teste Başla</button>
          </div>
        </div>

        <div class="quiz-card">
          <img src="/assets/images/generated/quiz_mitochondria.png" alt="Mitokondri ve Hücresel Enerji" class="quiz-card__img" />
          <div class="quiz-card__body">
            <span class="quiz-card__tag">Ücretsiz</span>
            <h3 class="quiz-card__title">Mitokondri & Hücresel Enerji Skoru</h3>
            <p class="quiz-card__desc">Hücresel enerji üretim kapasitenizi ve mitokondriyal sağlığınızı ölçün. Egzersiz, hormesis ve enerji faktörleri.</p>
            <div class="quiz-card__meta"><span>8 soru</span><span>~2 dakika</span></div>
            <button class="btn btn-dark" onclick="openQuiz('mitokondri')">Teste Başla</button>
          </div>
        </div>

      </div>
    </div></section>

  <!-- QUIZ MODAL -->
  <div class="quiz-modal" id="quizModal" role="dialog" aria-modal="true">
    <div class="quiz-modal__box">
      <div class="quiz-modal__head">
        <button class="quiz-modal__close" onclick="closeQuiz()" aria-label="Kapat">&#10005;</button>
        <div class="quiz-modal__head-title" id="modalTitle"></div>
        <div id="modalMeta" style="font-size:13px;opacity:.7;margin-top:4px;"></div>
        <div class="quiz-modal__progress-bar"><div class="quiz-modal__progress-fill" id="progressFill" style="width:0%"></div></div>
      </div>
      <div class="quiz-modal__body" id="modalBody"></div>
    </div>
  </div>

  <script is:inline>
  const QUIZZES = {
    vucut: {
      title: 'Vücut Tipi Quizi',
      meta: '12 soru · 3 dakika',
      questions: [
        { text: 'Yağ birikiminin en çok hangi bölgede olduğunu hissediyorsunuz?', options: [{ label: 'Karın ve bel çevresinde (stres kilogramı)', type: 'adrenal' }, { label: 'Tüm vücutta eşit dağılmış', type: 'tiroid' }, { label: 'Karın altında, pot belly görünümü', type: 'karaciger' }, { label: 'Kalça, uyluk ve bacaklarda', type: 'over' }] },
        { text: 'Genel enerji seviyenizi nasıl tanımlarsınız?', options: [{ label: 'Sabah çok düşük, geceye doğru daha iyi', type: 'adrenal' }, { label: 'Her zaman yorgun ve motivasyon düşük', type: 'tiroid' }, { label: 'Öğleden sonra ani çöküş yaşıyorum', type: 'karaciger' }, { label: 'Hormonal dönemler dışında genellikle iyi', type: 'over' }] },
        { text: 'Hangi yiyeceklere karşı güçlü bir istek duyuyorsunuz?', options: [{ label: 'Tuzlu ve yağlı yiyecekler', type: 'adrenal' }, { label: 'Her şey — iştahım çok açık', type: 'tiroid' }, { label: 'Kızarmış ve yağlı yiyecekler', type: 'karaciger' }, { label: 'Çikolata ve şekerli yiyecekler', type: 'over' }] },
        { text: 'Uyku kaliteniz nasıl?', options: [{ label: 'Uykuya dalmakta güçlük çekiyorum veya sık uyanıyorum', type: 'adrenal' }, { label: 'Çok uyuyorum ama yine de yorgun uyanıyorum', type: 'tiroid' }, { label: 'Gece iyi uyuyorum ama sabah yorgunluğu var', type: 'karaciger' }, { label: 'Hormonal dönemlerde uyku bozuluyor', type: 'over' }] },
        { text: 'Stres ve duygusal durumunuzu nasıl tanımlarsınız?', options: [{ label: 'Çok stresli ve kaygılı hissediyorum', type: 'adrenal' }, { label: 'Genellikle sakin ama motivasyon ve depresyon sorunum var', type: 'tiroid' }, { label: 'Sinirli veya öfkeli olabiliyorum', type: 'karaciger' }, { label: 'Duygusal değişkenlik ve dönemsel düşünceler yaşıyorum', type: 'over' }] },
        { text: 'Metabolizmanızı nasıl değerlendirirsiniz?', options: [{ label: 'Eskiye göre belirgin şekilde yavaşladı', type: 'adrenal' }, { label: 'Çok yavaş, ne yesem alıyorum', type: 'tiroid' }, { label: 'Şişkinlik ve sindirim sorunum çok var', type: 'karaciger' }, { label: 'Dönemsel değişkenlik, özellikle hormonal süreçlerde', type: 'over' }] },
        { text: 'Hangi fiziksel belirtilerle en çok karşılaşıyorsunuz?', options: [{ label: 'Çarpıntı, terleme, baş ağrısı', type: 'adrenal' }, { label: 'Soğuk eller-ayaklar, saç dökülmesi, kabızlık', type: 'tiroid' }, { label: 'Karın şişliği, gaz, karaciğer bölgesinde hassasiyet', type: 'karaciger' }, { label: 'Adet düzensizliği, PMS, su tutma', type: 'over' }] },
        { text: 'Sabahları ayna karşısında ne fark ediyorsunuz?', options: [{ label: 'Gözaltı morlukları veya şişlik', type: 'adrenal' }, { label: 'Soluk ten, kabaran yüz', type: 'tiroid' }, { label: 'Sarımtırak ten, dil üzerinde beyaz tabaka', type: 'karaciger' }, { label: 'Hormonlarla ilişkili cilt sorunları (akne, yağlanma)', type: 'over' }] },
        { text: 'Yemeklerden sonra sindirim sisteminiz nasıl tepki veriyor?', options: [{ label: 'Bazen, özellikle stresli dönemlerde mideme kramplar giriyor', type: 'adrenal' }, { label: 'Genellikle genel bir yavaşlık, aşırı şişkinlik ve kabızlık eşlik ediyor', type: 'tiroid' }, { label: 'Sağ kaburga altında dolgunluk, hazımsızlık veya gaz sık yaşanıyor', type: 'karaciger' }, { label: 'Genellikle sindirim sistemim gayet rahattır (özel günler hariç)', type: 'over' }] },
        { text: 'Egzersiz yaptıktan sonra kendinizi nasıl hissediyorsunuz?', options: [{ label: 'Aşırı bitkin düşüyorum ve toparlanmam saatler sürüyor', type: 'adrenal' }, { label: 'Genellikle yorgun ve halsiz hissediyorum ama normal sınırlarda kalıyor', type: 'tiroid' }, { label: 'Daha enerjik, hafiflemiş ve toksinlerden arınmış gibi hissediyorum', type: 'karaciger' }, { label: 'Genellikle gayet dengeli ve iyi hissediyorum', type: 'over' }] },
        { text: 'Ortam sıcaklığına karşı genel duyarlılığınız nasıl?', options: [{ label: 'Sıcak-soğuk geçişlerinde terleme, çarpıntı veya anksiyete hissi oluşuyor', type: 'adrenal' }, { label: 'Soğuğa aşırı hassasım; ellerim ve ayaklarım neredeyse hiç ısınmaz', type: 'tiroid' }, { label: 'Vücudumda içsel bir hararet var, sıcak basması ve terleme sık olur', type: 'karaciger' }, { label: 'Dönemsel sıcak basmaları yaşıyorum', type: 'over' }] },
        { text: 'Zihinsel odaklanma ve gün içi konsantrasyon durumunuzu en iyi hangisi tarif eder?', options: [{ label: 'Yoğun beyin sisi yaşıyorum; özellikle öğleden sonra odaklanmak imkansızlaşıyor', type: 'adrenal' }, { label: 'Sürekli bir uyuşukluk, odaklanma güçlüğü ve zihinsel yavaşlık hissediyorum', type: 'tiroid' }, { label: 'Sabahları odaksız ve huysuzum ancak gün ortasında zihnim tamamen açılıyor', type: 'karaciger' }, { label: 'Hormonal döngüme bağlı olarak konsantrasyonum çok değişken', type: 'over' }] },
      ],
      scoring: 'type',
      types: {
        adrenal: { label: 'Adrenal Tip', title: 'Adrenal Vücut Tipi', desc: 'Vücut tipiniz Adrenal tipe işaret ediyor. Bu tipte kortizol ve adrenalin hormonları baskın rol oynar. Stres bel ve karın çevresinde yağ birikimine, enerji çöküşlerine ve uyku sorunlarına yol açar.', pct: 75, tips: ['Günde 7–9 saat kaliteli uyku hedefleyin', 'Magnezyum ve B vitamini takviyeleri adrenal desteği sağlar', 'Aralıklı oruç (16:8) kortizol ritmine zarar vermeden uygulanabilir', 'Tuz kısıtlamasından kaçının — adrenal tip tuz ihtiyacı duyar', 'Meditasyon veya nefes egzersizleri ile stres yönetimi kritik'] },
        tiroid: { label: 'Tiroid Tip', title: 'Tiroid Vücut Tipi', desc: 'Vücut tipiniz Tiroid tipe işaret ediyor. Tiroid hormonu yavaşladığında tüm vücutta yağlanma, yorgunluk, soğukluk hissi ve metabolizma düşüklüğü görülür.', pct: 68, tips: ['İyot ve selenyum kaynakları tüketin (deniz ürünleri, ceviz)', 'Guatrojenik gıdaları pişirerek tüketin', 'D3 vitamini düzeyinizi kontrol ettirin', 'Düşük yoğunluklu egzersiz metabolizmayı uyarır', 'Gluten hassasiyeti tiroid üzerinde olumsuz etki yapabilir'] },
        karaciger: { label: 'Karaciğer Tip', title: 'Karaciğer Vücut Tipi', desc: 'Vücut tipiniz Karaciğer tipe işaret ediyor. Karaciğer aşırı yüklendiğinde karın altında pot belly tarzı yağlanma, şişkinlik ve sindirim sorunları görülür.', pct: 65, tips: ['Alkol ve işlenmiş yağları sınırlandırın', 'Hardal yaprağı, enginar, turp karaciğeri destekler', 'Sabah limonlu su karaciğer safra akışını uyarır', 'Sülfür içeren sebzeler (sarımsak, soğan) önemli', 'Derin nefes egzersizleri diyafram yoluyla karaciğere masaj yapar'] },
        over: { label: 'Over Tip', title: 'Over / Gonad Vücut Tipi', desc: 'Vücut tipiniz Over (Gonad) tipe işaret ediyor. Östrojen baskınlığı kalça, uyluk ve alt vücut yağlanmasına, duygusal değişkenliğe ve hormonal döngü sorunlarına neden olur.', pct: 70, tips: ['Çapraz sebzeler (brokoli, karnabahar) östrojen dengesini destekler', 'Şeker ve rafine karbonhidratları azaltın', 'Zinc ve B6 vitamini progesterone sentezi için gereklidir', 'Güçlendirme antrenmanı önceliklidir', 'Stres yönetimi kritik — kortizol progesteron çalar'] },
      }
    },
    longevity: {
      title: 'Longevity Skoru',
      meta: '15 soru · 4 dakika',
      questions: [
        { text: 'Haftada kaç gün en az 30 dakika egzersiz yapıyorsunuz?', options: [{ label: '0–1 gün', pts: 0 }, { label: '2–3 gün', pts: 1 }, { label: '4–5 gün', pts: 2 }, { label: '6–7 gün', pts: 3 }] },
        { text: 'Gecede ortalama kaç saat uyuyorsunuz?', options: [{ label: '5 saatten az', pts: 0 }, { label: '5–6 saat arası', pts: 1 }, { label: '7–8 saat (ideal)', pts: 3 }, { label: '9 saatten fazla', pts: 1 }] },
        { text: 'Sebze ve meyve tüketiminiz nasıl?', options: [{ label: 'Neredeyse hiç yemiyorum', pts: 0 }, { label: 'Haftada 1–2 kez', pts: 1 }, { label: 'Her gün 1–2 porsiyon', pts: 2 }, { label: 'Her gün 5+ porsiyon', pts: 3 }] },
        { text: 'İşlenmiş ve hazır gıda tüketiminiz ne sıklıkla?', options: [{ label: 'Her öğünde veya her gün', pts: 0 }, { label: 'Haftada 4–6 kez', pts: 1 }, { label: 'Haftada 1–3 kez', pts: 2 }, { label: 'Nadiren veya hiç', pts: 3 }] },
        { text: 'Stres seviyenizi nasıl değerlendiriyorsunuz?', options: [{ label: 'Sürekli yüksek stres altındayım', pts: 0 }, { label: 'Sıklıkla stresli hissediyorum', pts: 1 }, { label: 'Orta düzey, kontrol altında', pts: 2 }, { label: 'Genellikle sakin ve dengeli', pts: 3 }] },
        { text: 'Sigara veya tütün ürünleri kullanıyor musunuz?', options: [{ label: 'Evet, düzenli kullanıyorum', pts: 0 }, { label: 'Ara sıra kullanıyorum', pts: 1 }, { label: 'Bıraktım (1+ yıl önce)', pts: 2 }, { label: 'Hiç kullanmadım', pts: 3 }] },
