---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { sortPostsNewestFirst } from '../lib/posts';

const allPosts = await getCollection('blog');
const longevityPosts = sortPostsNewestFirst(
  allPosts.filter(post => post.data.category === 'Longevity Bilimi'),
).slice(0, 3);

const slug = (id: string) => id.replace(/\.mdx?$/, '');
const postBySlug = (s: string) => {
  const post = allPosts.find((p) => slug(p.id) === s);
  if (!post) throw new Error(`Longevity sayfası: makale bulunamadı: ${s}`);
  return { href: `/blog/${s}`, title: post.data.title };
};

const NOTE = 'Değerler literatürde sık anılan referans aralıklarıdır. Kişisel hedefler yaş, sağlık durumu ve kullanılan ilaçlara göre hekiminizle birlikte belirlenir.';

// Revizyon planı madde 16: "Tutarlı ve Uzun Yaşam" — 6 alan.
const areas = [
  {
    id: 'beslenme', title: 'Beslenme',
    icon: ['M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z', 'M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12'],
    desc: 'Sağlıklı yaşlanmada beslenme, tek bir "süper gıdadan" çok yıllar boyunca sürdürülebilen bir düzendir. Sebze, meyve, baklagil, tam tahıl ve yeterli protein içeren, işlenmiş gıdası az bir beslenme metabolik sağlığın temelidir.',
    points: [
      'Akdeniz tipi beslenme düzenleri, kalp-damar hastalığı riskinin daha düşük olmasıyla ilişkilendirilmektedir.',
      'Yaş ilerledikçe kas kütlesini korumak için yeterli protein alımı önem kazanır; ihtiyaç kişiye göre değişir.',
      'Lifli besinler bağırsak mikrobiyotasını ve kan şekeri dengesini destekler.',
    ],
    metrics: [
      { lbl: 'HbA1c (Üç Aylık Şeker)', val: '< %5.2', tip: 'Glukoz dalgalanmalarının az olması, damar sağlığını korumaya ve ileri glikasyon son ürünlerinin (AGEs) birikimini azaltmaya yardımcı olabilir.' },
      { lbl: 'ApoB (Aterojenik Lipoprotein)', val: '< 80 mg/dL', tip: 'Kardiyovasküler riski değerlendirmede kullanılan önemli belirteçlerden biridir; hedef değer kişisel risk profiline göre belirlenir.' },
    ],
    posts: ['mavi-bolge-diyeti', 'protein-ihtiyaci-yaslanma', 'lifli-beslenme-ve-mikrobiyota'],
  },
  {
    id: 'hareket', title: 'Hareket',
    icon: ['M22 12h-4l-3 9L9 3l-3 9H2'],
    desc: 'Düzenli fiziksel aktivite, sağlıklı yaşlanmayla en tutarlı biçimde ilişkilendirilen alışkanlıklardan biridir. Aerobik kapasite, kas gücü ve denge birlikte ele alınmalıdır.',
    points: [
      'Dünya Sağlık Örgütü yetişkinler için haftada en az 150 dakika orta yoğunlukta aerobik aktivite ve haftada 2 gün kas güçlendirici egzersiz önerir.',
      'Yüksek kardiyorespiratuvar kondisyon, tüm nedenlere bağlı ölüm riskinin daha düşük olmasıyla ilişkilidir.',
      'Denge çalışmaları ileri yaşta düşme riskini azaltmaya yardımcı olabilir.',
    ],
    metrics: [
      { lbl: 'VO2 Max', val: 'Yaş grubunun üst dilimleri', tip: 'Kendi yaş ve cinsiyet grubunuzun üst dilimlerinde yer almak, daha iyi yaşam kalitesi ve sağlık sonuçlarıyla ilişkilendirilmektedir.' },
      { lbl: 'Dinlenme Kalp Hızı', val: '< 60 bpm', tip: 'Düşük dinlenme kalp hızı çoğu zaman iyi kardiyovasküler kondisyonla ilişkilidir; sporcularda ve bazı ilaçları kullananlarda farklı yorumlanır.' },
      { lbl: 'Kas Kütlesi', val: 'Yaş grubunun üzeri', tip: 'DEXA gibi yöntemlerle ölçülen yeterli kas kütlesi, metabolik rezerv ve iskelet sağlığıyla ilişkilidir.' },
      { lbl: 'El Kavrama Gücü', val: 'Üst dilim skorları', tip: 'Genel fiziksel kapasiteyle ilişkili, basit ve yaygın kullanılan bir ölçümdür.' },
    ],
    posts: ['direnc-antrenmani-yaslanma', 'vo2max-ve-longevity', 'denge-egzersizleri-yaslanma'],
  },
  {
    id: 'uyku', title: 'Uyku',
    icon: ['M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z'],
    desc: 'Uyku; hafıza, metabolizma, bağışıklık ve duygu düzenlemesi için temel bir biyolojik ihtiyaçtır. Süresi kadar düzenliliği de önemlidir.',
    points: [
      'Yetişkinlerin çoğu için gecede 7 saat ve üzeri uyku önerilmektedir.',
      'Her gün benzer saatlerde yatıp kalkmak sirkadiyen ritmi destekler.',
      'Uzun süren uykusuzluk ya da uykuda horlama ve nefes durması gibi belirtiler hekim değerlendirmesi gerektirir.',
    ],
    metrics: [
      { lbl: 'Uyku Süresi', val: '7 saat ve üzeri', tip: 'Önerilen süre yaşa göre değişir; ihtiyacınızı uyku düzeniniz ve gün içindeki enerjiniz gösterir.' },
      { lbl: 'Derin Uyku Oranı', val: '%15 – %20', tip: 'Beynin glimfatik temizlik sisteminin özellikle derin uykuda daha aktif çalıştığı düşünülmektedir.' },
    ],
    posts: ['uyku-kalitesi-nasil-artirilir', 'sirkadiyen-ritim-ve-uyku', 'ekran-kullanimi-ve-uyku'],
  },
  {
    id: 'zihin', title: 'Zihin',
    icon: ['M12 2a7 7 0 0 0-4 12.7V17h8v-2.3A7 7 0 0 0 12 2Z', 'M9 21h6'],
    desc: 'Kronik stres; uyku, beslenme ve kalp-damar sağlığı üzerinden yaşlanma sürecini etkileyebilir. Zihinsel iyi oluş, sağlıklı yaşlanmanın ayrılmaz bir parçasıdır.',
    points: [
      'Kronik yüksek kortizol, uyku bozukluğu ve metabolik sorunlarla ilişkilendirilmektedir.',
      'Doğada vakit geçirmek, düzenli hareket ve nefes çalışmaları stres yönetimini destekleyebilir.',
      'Uzun süren kaygı ya da çökkünlük belirtilerinde bir ruh sağlığı uzmanından destek almak önemlidir.',
    ],
    metrics: [],
    posts: ['kortizol-yaslanma', 'tukenmislik-sendromu', 'doga-ve-zihin-sagligi'],
  },
  {
    id: 'sosyal-iliskiler', title: 'Sosyal İlişkiler',
    icon: ['M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2', 'M5 7a4 4 0 1 0 8 0a4 4 0 1 0-8 0', 'M22 21v-2a4 4 0 0 0-3-3.87', 'M16 3.13a4 4 0 0 1 0 7.75'],
    desc: 'Güçlü sosyal bağlar ve yaşamda bir amaç duygusu, uzun yaşamla ilişkilendirilen en tutarlı faktörlerden biridir.',
    points: [
      'Sosyal izolasyon ve yalnızlık, daha yüksek ölüm riskiyle ilişkilendirilmektedir.',
      'Yaşamda bir amaç duygusu, daha sağlıklı yaşlanmayla ilişkili bulunmuştur.',
      'Ortak etkinlikler, gönüllülük ve düzenli görüşmeler sosyal bağları güçlendirir.',
    ],
    metrics: [],
    posts: ['sosyal-baglanti-ve-uzun-omur', 'yasam-amaci-ve-longevity', 'sukran-pratigi-ve-dopamin'],
  },
  {
    id: 'skin-longevity', title: 'Skin Longevity',
    icon: ['M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z'],
    desc: 'Cilt, yaşlanmanın en görünür yüzüdür. Skin longevity; güneşten korunma, cilt bariyerinin desteklenmesi ve uygun hastalarda medikal estetik uygulamalarla cildin uzun vadeli sağlığını hedefler.',
    points: [
      'Güneşten korunma, ciltte fotoyaşlanmayı azaltmada en güçlü kanıta sahip yaklaşımdır.',
      'Retinoidler, cilt yaşlanması bulgularında en çok çalışılmış topikal ajanlardandır.',
      'Medikal estetik uygulamalar kişisel değerlendirmeyle ve gerçekçi beklentilerle planlanmalıdır.',
    ],
    metricsTitle: 'Uygulamalar ve Hedeflenen Etkiler',
    metrics: [
      { lbl: 'PRP & Eksozom', val: 'Rejeneratif uygulamalar', tip: 'Hücreler arası iletişimi destekleyerek doku onarımına ve kolajen–elastin yapımına katkı sağlamayı hedefler.' },
      { lbl: 'Altın İğne (RF)', val: 'Fraksiyonel radyofrekans', tip: 'Mikro iğnelerle oluşturulan kontrollü ısı etkisiyle yeni kolajen oluşumunu uyarmayı ve cilt sıkılığını artırmayı hedefler.' },
    ],
    posts: ['gunes-kremi-nasil-secilir', 'retinoid-nedir', 'ciltte-kollajen-kaybi'],
    more: { href: '/medikal-estetik', label: 'Skin Longevity & Medikal Estetik sayfası' },
  },
].map((area) => ({ ...area, links: area.posts.map(postBySlug) }));

// Hücresel temeller: yaşlanma biyolojisinin araştırma alanları (Longevity Bilimi kategorisi).
const cellular = [
  { id: 'otofaji', title: 'Otofaji', text: 'Hücrelerin hasarlı bileşenlerini parçalayıp geri dönüştürdüğü temizlik mekanizması. Oruç ve egzersizle ilişkisi daha çok hayvan çalışmalarında gösterilmiştir.', post: 'otofaji-nedir' },
  { id: 'mitokondri', title: 'Mitokondri', text: 'Hücrenin enerji üretim merkezleri. Düzenli egzersiz, mitokondriyal kapasiteyi destekleyen en güçlü uyaranlardan biridir.', post: 'mitokondri-sagligi-nasil-desteklenir' },
  { id: 'telomerler', title: 'Telomerler', text: 'Kromozom uçlarındaki koruyucu yapılar. Kısalmaları biyolojik yaşlanmayla ilişkilendirilir; yaşam tarzı da bu süreci etkileyebilir.', post: 'telomerleri-korumak' },
  { id: 'nad', title: 'NAD+', text: 'Enerji metabolizması ve DNA onarımında görev alan bir koenzim; düzeyi yaşla azalır. Takviyelerin insanlardaki etkileri hâlâ araştırılmaktadır.', post: 'nmn-nad-yaslanma' },
].map((c) => ({ ...c, link: postBySlug(c.post) }));
---
<BaseLayout title="Tutarlı ve Uzun Yaşam — Longevity — Dr. Muhammed İkbal Bakırcı" description="Sağlıklı yaş almanın 6 alanı: beslenme, hareket, uyku, zihin, sosyal ilişkiler ve skin longevity. Longevity bilimine temkinli ve bütüncül bir bakış.">
  <style is:global>
    /* ─── PREMIUM STYLE TOKENS & ANIMATIONS ─── */
    @keyframes glowPulse {
      0% { box-shadow: 0 0 15px rgba(59, 173, 73, 0.15); }
      50% { box-shadow: 0 0 30px rgba(59, 173, 73, 0.35); }
      100% { box-shadow: 0 0 15px rgba(59, 173, 73, 0.15); }
    }
    @keyframes floatLight {
      0% { transform: translateY(0px) rotate(0deg); }
      50% { transform: translateY(-10px) rotate(2deg); }
      100% { transform: translateY(0px) rotate(0deg); }
    }

    /* 1. IMMERSIVE HERO SECTION */
    .lg-hero {
      background: radial-gradient(circle at 50% -20%, #162419 0%, #080a08 60%, #040504 100%);
      color: #e5ede7;
      padding: 140px 0 120px;
      text-align: center;
      position: relative;
      overflow: hidden;
      border-bottom: 1px solid rgba(59, 173, 73, 0.08);
    }
    .lg-hero__container {
      max-width: 900px;
      margin: 0 auto;
      padding: 0 24px;
      position: relative;
      z-index: 2;
    }
    .lg-hero__tag {
      background: rgba(59, 173, 73, 0.1);
      color: #4ed961;
      border: 1px solid rgba(59, 173, 73, 0.25);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 2.5px;
      padding: 6px 18px;
      border-radius: 100px;
      text-transform: uppercase;
      display: inline-block;
      margin-bottom: 28px;
      backdrop-filter: blur(4px);
    }
    .lg-hero__title {
      font-family: Georgia, serif;
      font-size: clamp(36px, 5.5vw, 60px);
      font-weight: 300;
      line-height: 1.15;
      letter-spacing: -1px;
      color: #f5f8f6;
      margin-bottom: 28px;
    }
    .lg-hero__title span {
      font-weight: 800;
      background: linear-gradient(135deg, #ffffff 30%, #a4e6ac 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .lg-hero__sub {
      font-size: 18px;
      line-height: 1.8;
      color: #a4b49f;
      max-width: 720px;
      margin: 0 auto 44px;
    }
    .lg-hero__actions {
      display: flex;
      gap: 16px;
      justify-content: center;
      flex-wrap: wrap;
    }
    .btn-glow {
      background: #3BAD49;
      color: #fff;
      border: none;
      animation: glowPulse 3s infinite ease-in-out;
      transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
    }
    .btn-glow:hover {
      background: #45c454;
      transform: translateY(-2px);
      box-shadow: 0 10px 25px rgba(59, 173, 73, 0.4);
    }
    .lg-hero__btn-sec {
      background: rgba(255, 255, 255, 0.03);
      color: #fff;
      border: 1px solid rgba(255, 255, 255, 0.15);
      backdrop-filter: blur(10px);
      transition: all 0.3s;
    }
    .lg-hero__btn-sec:hover {
      background: rgba(255, 255, 255, 0.08);
      border-color: rgba(255, 255, 255, 0.3);
    }

    /* 2. PHILOSOPHY & SVG CHART SECTION */
    .philosophy-section {
      background: var(--base);
      padding: 110px 0;
      position: relative;
    }
    .philosophy-grid {
      display: grid;
      grid-template-columns: 1.1fr 1.2fr;
      gap: 60px;
      align-items: center;
    }
    @media(max-width: 992px) {
      .philosophy-grid {
        grid-template-columns: 1fr;
        gap: 48px;
      }
    }
    .philosophy-text__badge {
      color: var(--green);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      margin-bottom: 14px;
      display: block;
    }
    .philosophy-text__title {
      font-family: Georgia, serif;
      font-size: clamp(28px, 4vw, 38px);
      font-weight: 700;
      line-height: 1.25;
      margin-bottom: 24px;
      color: var(--main);
    }
    .philosophy-text__p {
      font-size: 16px;
      color: var(--gray-700);
      line-height: 1.8;
      margin-bottom: 20px;
    }
    .philosophy-text__p strong {
      color: var(--main);
    }

    /* Elegant SVG Chart */
    .chart-container {
      background: #0f1310;
      border-radius: 24px;
      border: 1px solid rgba(59, 173, 73, 0.15);
      padding: 36px 30px;
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
      position: relative;
      overflow: hidden;
    }
    .chart-container::before {
      content: '';
      position: absolute;
      top: -50px;
      right: -50px;
      width: 150px;
      height: 150px;
      background: radial-gradient(circle, rgba(59, 173, 73, 0.06) 0%, transparent 70%);
      pointer-events: none;
    }
    .chart-title {
      font-size: 16px;
      font-weight: 700;
      color: #fff;
      margin-bottom: 24px;
      text-transform: uppercase;
      letter-spacing: 1px;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .chart-title::before {
      content: '';
      width: 8px;
      height: 8px;
      background: #3BAD49;
      border-radius: 50%;
      box-shadow: 0 0 10px #3BAD49;
    }
    .health-curve-svg {
      display: block;
      width: 100%;
      height: auto;
      overflow: visible;
    }
    .chart-legend {
      display: flex;
      gap: 20px;
      margin-top: 24px;
      flex-wrap: wrap;
      justify-content: center;
      padding-top: 16px;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
    }
    .chart-note {
      margin-top: 12px;
      font-size: 12px;
      color: #a4b49f;
      text-align: center;
    }
    .legend-item {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      color: #a4b49f;
    }
    .legend-color {
      width: 12px;
      height: 12px;
      border-radius: 3px;
    }
    .legend-color--traditional {
      background: #8e9ba2;
      border: 1px dashed rgba(255, 255, 255, 0.3);
    }
    .legend-color--longevity {
      background: linear-gradient(135deg, #3BAD49, #4ed961);
      box-shadow: 0 0 8px rgba(59, 173, 73, 0.6);
    }

    /* Tooltip styles inside SVG or overlay */
    .chart-tooltip {
      position: absolute;
      background: rgba(15, 20, 16, 0.95);
      border: 1px solid rgba(59, 173, 73, 0.3);
      padding: 10px 14px;
      border-radius: 8px;
      font-size: 12px;
      color: #e5ede7;
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.2s, transform 0.2s;
      transform: translate(-50%, -110%);
      z-index: 10;
      box-shadow: 0 8px 24px rgba(0,0,0,0.3);
      backdrop-filter: blur(8px);
      width: max-content;
      max-width: 220px;
    }
    .chart-tooltip strong {
      color: #4ed961;
      display: block;
      margin-bottom: 4px;
    }

    /* Interactive Dot styling */
    .interactive-dot {
      cursor: pointer;
      transition: r 0.2s, stroke-width 0.2s;
    }
    .interactive-dot:hover {
      r: 8 !important;
      stroke-width: 4 !important;
    }

    /* 3. INTERACTIVE BIOLOGICAL AGE CALCULATOR */
    .calc-section {
      background: var(--tertiary);
      padding: 100px 0;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }
    .calc-header {
      text-align: center;
      max-width: 700px;
      margin: 0 auto 56px;
    }
    .calc-header__title {
      font-family: Georgia, serif;
      font-size: clamp(28px, 4vw, 36px);
      font-weight: 700;
      margin-bottom: 16px;
      color: var(--main);
    }
    .calc-header__desc {
      color: var(--gray-500);
      font-size: 16px;
      line-height: 1.6;
    }
    .calc-card {
      background: var(--base);
      border-radius: 28px;
      border: 1px solid rgba(0, 0, 0, 0.05);
      padding: 48px;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.02);
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 60px;
    }
    @media(max-width: 992px) {
      .calc-card {
        grid-template-columns: 1fr;
        gap: 40px;
        padding: 32px 24px;
      }
    }
    .calc-sliders {
      display: flex;
      flex-direction: column;
      gap: 28px;
    }
    .slider-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .slider-label {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 14px;
      font-weight: 700;
      color: var(--main);
    }
    .slider-desc {
      font-size: 12px;
      color: var(--gray-500);
      margin-top: -4px;
    }
    .slider-input-wrapper {
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .slider-control {
      flex-grow: 1;
      height: 6px;
      -webkit-appearance: none;
      appearance: none;
      background: var(--border);
      border-radius: 10px;
      outline: none;
      transition: background 0.3s;
    }
    .slider-control::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 20px;
      height: 20px;
      border-radius: 50%;
      background: #3BAD49;
      cursor: pointer;
      border: 2px solid #fff;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
      transition: transform 0.2s;
    }
    .slider-control::-webkit-slider-thumb:hover {
      transform: scale(1.2);
    }
    .slider-val {
      font-size: 14px;
      font-weight: 700;
      color: #3BAD49;
      min-width: 45px;
      text-align: right;
    }

    /* Calculator Results Visual */
    .calc-results {
      background: radial-gradient(circle at center, #111612 0%, #060807 100%);
      border-radius: 20px;
      padding: 40px 30px;
      color: #fff;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      position: relative;
      border: 1px solid rgba(59, 173, 73, 0.2);
    }
    .results-ring-container {
      position: relative;
      width: 180px;
      height: 180px;
      margin-bottom: 24px;
    }
    .results-ring-svg {
      width: 100%;
      height: 100%;
      transform: rotate(-90deg);
    }
    .results-ring-bg {
      fill: none;
      stroke: rgba(255, 255, 255, 0.05);
      stroke-width: 10;
    }
    .results-ring-fill {
      fill: none;
      stroke: #3BAD49;
      stroke-width: 10;
      stroke-linecap: round;
      transition: stroke-dashoffset 0.5s ease;
      filter: drop-shadow(0 0 6px rgba(59, 173, 73, 0.6));
    }
    .results-ring-text {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .results-ring-val {
      font-size: 32px;
      font-weight: 800;
      color: #fff;
      line-height: 1;
    }
    .results-ring-lbl {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: #a4b49f;
      margin-top: 4px;
    }
