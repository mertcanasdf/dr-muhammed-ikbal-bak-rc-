---
import { getArticleMetrics } from '../lib/article-metrics';
import CardImage from '../components/CardImage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { sortPostsNewestFirst } from '../lib/posts';

const allPosts = await getCollection('blog');
const relatedPosts = sortPostsNewestFirst(
  allPosts.filter(post => ['Beslenme', 'Hareket', 'Uyku', 'Zihin & Sosyal Yaşam'].includes(post.data.category)),
).slice(0, 3);

const slug = (id: string) => id.replace(/\.mdx?$/, '');
---
<BaseLayout title="Rehberler — Dr. Muhammed İkbal Bakırcı" pageType="CollectionPage">
  <style is:global>
    .pg-hero{background:var(--main);color:#fff;padding:80px 0;}
    .pg-hero__title{font-size:clamp(32px,5vw,52px);font-weight:900;margin-bottom:16px;}
    .pg-hero__sub{font-size:18px;opacity:.75;max-width:640px;}
    .guides-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:28px;padding:64px 0;}
    @media(max-width:700px){.guides-grid{grid-template-columns:1fr;}}
    .guide-card{background:var(--base);border-radius:var(--r-lg);overflow:hidden;box-shadow:var(--shadow);transition:box-shadow .2s,transform .2s;}
    .guide-card:hover{box-shadow:var(--shadow-md);transform:translateY(-2px);}
    .guide-card__img{width:100%;aspect-ratio:16/9;object-fit:cover;}
    .guide-card__body{padding:24px;}
    .guide-card__tag{font-size: 12px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--primary);background:var(--tertiary);padding:3px 10px;border-radius:99px;display:inline-block;margin-bottom:12px;}
    .guide-card__title{font-size:18px;font-weight:700;margin-bottom:8px;}
    .guide-card__desc{font-size:14px;color:var(--gray-500);line-height:1.6;margin-bottom:16px;}
    .guide-card__cta{font-size:13px;font-weight:700;color:var(--blue);}
    .guide-card__cta:hover{text-decoration:underline;}
  </style>

    <section class="pg-hero"><div class="container"><h1 class="pg-hero__title">Sağlık Rehberleri</h1><p class="pg-hero__sub">Kanıta dayalı, günlük hayata uygulanabilir rehberler: beslenme, hareket, uyku, stres yönetimi ve cilt sağlığı.</p></div></section>
    <section class="section"><div class="container">
      <div class="guides-grid">
        <div class="guide-card"><CardImage src="/assets/images/generated/nutrition-longevity.webp" alt="Sağlıklı yaş almak için dengeli yaşam" class="guide-card__img" /><div class="guide-card__body"><span class="guide-card__tag">Başlangıç</span><h3 class="guide-card__title">Longevity’e Nasıl Başlarım?</h3><p class="guide-card__desc">Beslenme, hareket, uyku, zihin, sosyal ilişkiler ve cilt sağlığından oluşan 6 alanı ve her alanda kanıtı en güçlü ilk adımları özetleyen genel çerçeve.</p><a href="/longevity" class="guide-card__cta">Okumaya başla &rarr;</a></div></div>
        <div class="guide-card"><CardImage src="/assets/images/generated/guide_intermittent_fasting.webp" alt="Aralıklı oruç için saat ve tabak" class="guide-card__img" /><div class="guide-card__body"><span class="guide-card__tag">Beslenme</span><h3 class="guide-card__title">Aralıklı Oruç (16:8) Kılavuzu</h3><p class="guide-card__desc">16:8 ve diğer aralıklı oruç protokolleri nasıl uygulanır, insan çalışmaları ne gösteriyor ve kimler başlamadan önce hekime danışmalı?</p><a href="/blog/aralikli-oruc-longevity" class="guide-card__cta">Makaleyi oku &rarr;</a></div></div>
        <div class="guide-card"><CardImage src="/assets/images/generated/guide_keto_diet.webp" alt="Protein içeren dengeli bir tabak" class="guide-card__img" /><div class="guide-card__body"><span class="guide-card__tag">Beslenme</span><h3 class="guide-card__title">Yaşlanırken Protein ve Kas</h3><p class="guide-card__desc">Yaş ilerledikçe kas kütlesini korumak için ne kadar protein gerekir, hangi besinlerden alınır ve direnç antrenmanıyla nasıl birleştirilir?</p><a href="/blog/protein-ihtiyaci-yaslanma" class="guide-card__cta">Makaleyi oku &rarr;</a></div></div>
        <div class="guide-card"><CardImage src="/assets/images/generated/stress-sleep.webp" alt="Akşam uyku rutini için sakin bir yatak odası" class="guide-card__img" /><div class="guide-card__body"><span class="guide-card__tag">Uyku</span><h3 class="guide-card__title">Uyku Kalitesi Rehberi</h3><p class="guide-card__desc">Uyku hijyeni, düzenli uyku saatleri, akşam rutini ve hangi durumlarda hekime başvurulması gerektiği üzerine uygulanabilir öneriler.</p><a href="/blog/uyku-kalitesi-nasil-artirilir" class="guide-card__cta">Makaleyi oku &rarr;</a></div></div>
        <div class="guide-card"><CardImage src="/assets/images/generated/exercise.webp" alt="Doğada yürüyüş yolu" class="guide-card__img" /><div class="guide-card__body"><span class="guide-card__tag">Hareket</span><h3 class="guide-card__title">Kardiyo, Kuvvet ve Denge</h3><p class="guide-card__desc">Zone 2 kardiyo, direnç antrenmanı ve denge egzersizlerini bir araya getiren, Dünya Sağlık Örgütü önerilerine dayanan hareket rehberi ve ilgili yazılar.</p><a href="/longevity/hareket" class="guide-card__cta">Rehbere git &rarr;</a></div></div>
        <div class="guide-card"><CardImage src="/assets/images/generated/guide_cortisol_stress.webp" alt="Sakin bir sabah için çay ve kitap" class="guide-card__img" /><div class="guide-card__body"><span class="guide-card__tag">Stres</span><h3 class="guide-card__title">Stres ve Kortizol</h3><p class="guide-card__desc">Kronik stresin uyku, metabolizma ve yaşlanma üzerindeki etkileri ile stresi yönetmede kanıtı olan adımlar: uyku, hareket, yavaş nefes ve sosyal destek.</p><a href="/blog/kortizol-yaslanma" class="guide-card__cta">Makaleyi oku &rarr;</a></div></div>
        <div class="guide-card"><CardImage src="/assets/images/generated/success-story.webp" alt="Cilt bakım ürünleri ve havlu" class="guide-card__img" /><div class="guide-card__body"><span class="guide-card__tag">Cilt Sağlığı</span><h3 class="guide-card__title">Cilt Sağlığının Temelleri</h3><p class="guide-card__desc">Güneş koruması, cilt bariyeri ve retinoidler: cilt yaşlanmasında kanıtı en güçlü günlük bakım adımları ve doğru ürün seçimi.</p><a href="/blog/gunes-kremi-nasil-secilir" class="guide-card__cta">Okumaya başla &rarr;</a></div></div>
        <div class="guide-card"><CardImage src="/assets/images/generated/online-course.webp" alt="Medikal estetik değerlendirme masası" class="guide-card__img" /><div class="guide-card__body"><span class="guide-card__tag">Medikal Estetik</span><h3 class="guide-card__title">Medikal Estetik Uygulamalar Rehberi</h3><p class="guide-card__desc">Botoks, dermal dolgu, altın iğne, PRP ve mezoterapi nasıl çalışır, kanıtlar ve olası riskler neler? Uygulama öncesi bilinmesi gerekenler.</p><a href="/medikal-estetik" class="guide-card__cta">Keşfet &rarr;</a></div></div>
      </div>
    </div></section>

  <!-- RELATED ARTICLES -->
  <section class="related-blogs-section" style="background: var(--tertiary); padding: 80px 0; border-top: 1px solid var(--border);">
    <div class="container">
      <div class="section-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px;">
        <h2 class="section-title">Rehberlik Eden Sağlık Makaleleri</h2>
        <a href="/blog" class="section-link">Tüm Kütüphaneyi Gör &rarr;</a>
      </div>
      <div class="blog-grid" style="padding-top: 0; padding-bottom: 0;">
        {relatedPosts.map(post => (
          <article class="blog-card">
            <a href={`/blog/${slug(post.id)}`}>
              <CardImage src={post.data.image} alt={post.data.title} class="blog-card__img" />
            </a>
            <div class="blog-card__body">
              <span class="blog-card__cat">{post.data.category}</span>
              <h2 class="blog-card__title">
                <a href={`/blog/${slug(post.id)}`}>{post.data.title}</a>
              </h2>
              <p class="blog-card__excerpt">{post.data.description}</p>
              <div class="blog-card__meta">
                <span>{post.data.date.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
                <span>{getArticleMetrics(post.body ?? '').readTime} okuma</span>
              </div>
              <a href={`/blog/${slug(post.id)}`} class="blog-card__read-more">Devamını oku &rarr;</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
