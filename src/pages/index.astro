    <script is:inline>
      function repairSplideSlideRoles() {
        document.querySelectorAll(
          '#successSplide .splide__slide[role="tabpanel"], #podcastSplide .splide__slide[role="tabpanel"]'
        ).forEach(function (slide) {
          slide.setAttribute('role', 'group');
          slide.removeAttribute('aria-roledescription');
        });
      }
      var splideRoleObserver = new MutationObserver(repairSplideSlideRoles);
      splideRoleObserver.observe(document.body, { subtree: true, attributes: true, attributeFilter: ['role'] });
      repairSplideSlideRoles();
      document.addEventListener('astro:page-load', repairSplideSlideRoles);
    </script>

