---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { sortPostsNewestFirst } from '../lib/posts';

const allPosts = await getCollection('blog');
const longevityPosts = sortPostsNewestFirst(
  allPosts.filter(post => ['Longevity Bilimi', 'Hareket'].includes(post.data.category)),
).slice(0, 3);

const slug = (id: string) => id.replace(/\.mdx?$/, '');
---
<BaseLayout title="Longevity — Dr. Muhammed İkbal Bakırcı" description="Biyolojik yaşınızı genç tutun, sağlık ömrünüzü destekleyin. Longevity bilimi, 6 temel sütun ve günlük yaşam yaklaşımı.">
  <style is:global>
    /* ─── PREMIUM STYLE TOKENS & ANIMATIONS ─── */
    @keyframes glowPulse {
      0% { box-shadow: 0 0 15px rgba(59, 173, 73, 0.15); }
      50% { box-shadow: 0 0 30px rgba(59, 173, 73, 0.35); }
      100% { box-shadow: 0 0 15px rgba(59, 173, 73, 0.15); }
    }
    @keyframes floatLight {
      0% { transform: translateY(0px) rotate(0deg); }
      50% { transform: translateY(-10px) rotate(2deg); }
      100% { transform: translateY(0px) rotate(0deg); }
    }

    /* 1. IMMERSIVE HERO SECTION */
    .lg-hero {
      background: radial-gradient(circle at 50% -20%, #162419 0%, #080a08 60%, #040504 100%);
      color: #e5ede7;
      padding: 140px 0 120px;
      text-align: center;
      position: relative;
      overflow: hidden;
      border-bottom: 1px solid rgba(59, 173, 73, 0.08);
    }
    .lg-hero__container {
      max-width: 900px;
      margin: 0 auto;
      padding: 0 24px;
      position: relative;
      z-index: 2;
    }
    .lg-hero__tag {
      background: rgba(59, 173, 73, 0.1);
      color: #4ed961;
      border: 1px solid rgba(59, 173, 73, 0.25);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 2.5px;
      padding: 6px 18px;
      border-radius: 100px;
      text-transform: uppercase;
      display: inline-block;
      margin-bottom: 28px;
      backdrop-filter: blur(4px);
    }
    .lg-hero__title {
      font-family: Georgia, serif;
      font-size: clamp(36px, 5.5vw, 60px);
      font-weight: 300;
      line-height: 1.15;
      letter-spacing: -1px;
      color: #f5f8f6;
      margin-bottom: 28px;
    }
    .lg-hero__title span {
      font-weight: 800;
      background: linear-gradient(135deg, #ffffff 30%, #a4e6ac 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .lg-hero__sub {
      font-size: 18px;
      line-height: 1.8;
      color: #a4b49f;
      max-width: 720px;
      margin: 0 auto 44px;
    }
    .lg-hero__actions {
      display: flex;
      gap: 16px;
      justify-content: center;
      flex-wrap: wrap;
    }
    .btn-glow {
      background: #3BAD49;
      color: #fff;
      border: none;
      animation: glowPulse 3s infinite ease-in-out;
      transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
    }
    .btn-glow:hover {
      background: #45c454;
      transform: translateY(-2px);
      box-shadow: 0 10px 25px rgba(59, 173, 73, 0.4);
    }
    .lg-hero__btn-sec {
      background: rgba(255, 255, 255, 0.03);
      color: #fff;
      border: 1px solid rgba(255, 255, 255, 0.15);
      backdrop-filter: blur(10px);
      transition: all 0.3s;
    }
    .lg-hero__btn-sec:hover {
      background: rgba(255, 255, 255, 0.08);
      border-color: rgba(255, 255, 255, 0.3);
    }

    /* 2. PHILOSOPHY & SVG CHART SECTION */
    .philosophy-section {
      background: var(--base);
      padding: 110px 0;
      position: relative;
    }
    .philosophy-grid {
      display: grid;
      grid-template-columns: 1.1fr 1.2fr;
      gap: 60px;
      align-items: center;
    }
    @media(max-width: 992px) {
      .philosophy-grid {
        grid-template-columns: 1fr;
        gap: 48px;
      }
    }
    .philosophy-text__badge {
      color: var(--green);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      margin-bottom: 14px;
      display: block;
    }
    .philosophy-text__title {
      font-family: Georgia, serif;
      font-size: clamp(28px, 4vw, 38px);
      font-weight: 700;
      line-height: 1.25;
      margin-bottom: 24px;
      color: var(--main);
    }
    .philosophy-text__p {
      font-size: 16px;
      color: var(--gray-700);
      line-height: 1.8;
      margin-bottom: 20px;
    }
    .philosophy-text__p strong {
      color: var(--main);
    }

    /* Elegant SVG Chart */
    .chart-container {
      background: #0f1310;
      border-radius: 24px;
      border: 1px solid rgba(59, 173, 73, 0.15);
      padding: 36px 30px;
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
      position: relative;
      overflow: hidden;
    }
    .chart-container::before {
      content: '';
      position: absolute;
      top: -50px;
      right: -50px;
      width: 150px;
      height: 150px;
      background: radial-gradient(circle, rgba(59, 173, 73, 0.06) 0%, transparent 70%);
      pointer-events: none;
    }
    .chart-title {
      font-size: 16px;
      font-weight: 700;
      color: #fff;
      margin-bottom: 24px;
      text-transform: uppercase;
      letter-spacing: 1px;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .chart-title::before {
      content: '';
      width: 8px;
      height: 8px;
      background: #3BAD49;
      border-radius: 50%;
      box-shadow: 0 0 10px #3BAD49;
    }
    .health-curve-svg {
      display: block;
      width: 100%;
      height: auto;
      overflow: visible;
    }
    .chart-legend {
      display: flex;
      gap: 20px;
      margin-top: 24px;
      flex-wrap: wrap;
      justify-content: center;
      padding-top: 16px;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
    }
    .legend-item {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      color: #a4b49f;
    }
    .legend-color {
      width: 12px;
      height: 12px;
      border-radius: 3px;
    }
    .legend-color--traditional {
      background: #8e9ba2;
      border: 1px dashed rgba(255, 255, 255, 0.3);
    }
    .legend-color--longevity {
      background: linear-gradient(135deg, #3BAD49, #4ed961);
      box-shadow: 0 0 8px rgba(59, 173, 73, 0.6);
    }

    /* Tooltip styles inside SVG or overlay */
    .chart-tooltip {
      position: absolute;
      background: rgba(15, 20, 16, 0.95);
      border: 1px solid rgba(59, 173, 73, 0.3);
      padding: 10px 14px;
      border-radius: 8px;
      font-size: 12px;
      color: #e5ede7;
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.2s, transform 0.2s;
      transform: translate(-50%, -110%);
      z-index: 10;
      box-shadow: 0 8px 24px rgba(0,0,0,0.3);
      backdrop-filter: blur(8px);
      width: max-content;
      max-width: 220px;
    }
    .chart-tooltip strong {
      color: #4ed961;
      display: block;
      margin-bottom: 4px;
    }

    /* Interactive Dot styling */
    .interactive-dot {
      cursor: pointer;
      transition: r 0.2s, stroke-width 0.2s;
    }
    .interactive-dot:hover {
      r: 8 !important;
      stroke-width: 4 !important;
    }

    /* 3. INTERACTIVE BIOLOGICAL AGE CALCULATOR */
    .calc-section {
      background: var(--tertiary);
      padding: 100px 0;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }
    .calc-header {
      text-align: center;
      max-width: 700px;
      margin: 0 auto 56px;
    }
    .calc-header__title {
      font-family: Georgia, serif;
      font-size: clamp(28px, 4vw, 36px);
      font-weight: 700;
      margin-bottom: 16px;
      color: var(--main);
    }
    .calc-header__desc {
      color: var(--gray-500);
      font-size: 16px;
      line-height: 1.6;
    }
    .calc-card {
      background: var(--base);
      border-radius: 28px;
      border: 1px solid rgba(0, 0, 0, 0.05);
      padding: 48px;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.02);
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 60px;
    }
    @media(max-width: 992px) {
      .calc-card {
        grid-template-columns: 1fr;
        gap: 40px;
        padding: 32px 24px;
      }
    }
    .calc-sliders {
      display: flex;
      flex-direction: column;
      gap: 28px;
    }
    .slider-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .slider-label {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 14px;
      font-weight: 700;
      color: var(--main);
    }
    .slider-desc {
      font-size: 12px;
      color: var(--gray-500);
      margin-top: -4px;
    }
    .slider-input-wrapper {
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .slider-control {
      flex-grow: 1;
      height: 6px;
      -webkit-appearance: none;
      appearance: none;
      background: var(--border);
      border-radius: 10px;
      outline: none;
      transition: background 0.3s;
    }
    .slider-control::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 20px;
      height: 20px;
      border-radius: 50%;
      background: #3BAD49;
      cursor: pointer;
      border: 2px solid #fff;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
      transition: transform 0.2s;
    }
    .slider-control::-webkit-slider-thumb:hover {
      transform: scale(1.2);
    }
    .slider-val {
      font-size: 14px;
      font-weight: 700;
      color: #3BAD49;
      min-width: 45px;
      text-align: right;
    }

    /* Calculator Results Visual */
    .calc-results {
      background: radial-gradient(circle at center, #111612 0%, #060807 100%);
      border-radius: 20px;
      padding: 40px 30px;
      color: #fff;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      position: relative;
      border: 1px solid rgba(59, 173, 73, 0.2);
    }
    .results-ring-container {
      position: relative;
      width: 180px;
      height: 180px;
      margin-bottom: 24px;
    }
    .results-ring-svg {
      width: 100%;
      height: 100%;
      transform: rotate(-90deg);
    }
    .results-ring-bg {
      fill: none;
      stroke: rgba(255, 255, 255, 0.05);
      stroke-width: 10;
    }
    .results-ring-fill {
      fill: none;
      stroke: #3BAD49;
      stroke-width: 10;
      stroke-linecap: round;
      transition: stroke-dashoffset 0.5s ease;
      filter: drop-shadow(0 0 6px rgba(59, 173, 73, 0.6));
    }
    .results-ring-text {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .results-ring-val {
      font-size: 32px;
      font-weight: 800;
      color: #fff;
      line-height: 1;
    }
    .results-ring-lbl {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: #a4b49f;
      margin-top: 4px;
    }
    .calc-outcome__title {
      font-size: 20px;
      font-weight: 700;
      margin-bottom: 12px;
      color: #fff;
    }
    .calc-outcome__title span {
      color: #4ed961;
    }
    .calc-outcome__desc {
      font-size: 14px;
      color: #a4b49f;
      line-height: 1.6;
      margin-bottom: 20px;
      max-width: 320px;
    }
    .calc-outcome__tip {
      font-size: 12px;
      background: rgba(59, 173, 73, 0.08);
      border: 1px solid rgba(59, 173, 73, 0.2);
      border-radius: 8px;
      padding: 10px 14px;
      color: #e5ede7;
      text-align: left;
      line-height: 1.5;
    }

    /* 4. THE 5 PILLARS OF LONGEVITY (EXPANDABLE) */
    .pillars-section {
      background: var(--base);
      padding: 100px 0;
    }
    .pillars-header {
      text-align: center;
      max-width: 700px;
      margin: 0 auto 60px;
    }
    .pillars-header__title {
      font-family: Georgia, serif;
      font-size: clamp(28px, 4vw, 36px);
      font-weight: 700;
      margin-bottom: 16px;
      color: var(--main);
    }
    .pillars-header__desc {
      color: var(--gray-500);
      font-size: 16px;
      line-height: 1.6;
    }
    .pillars-list {
      display: flex;
      flex-direction: column;
      gap: 20px;
      max-width: 900px;
      margin: 0 auto;
    }
    .pillar-item {
      border: 1px solid var(--border);
      border-radius: 16px;
      background: var(--base);
      overflow: hidden;
      transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
    }
    .pillar-item:hover {
      border-color: rgba(59, 173, 73, 0.3);
      box-shadow: 0 4px 20px rgba(0,0,0,0.02);
    }
    .pillar-item.active {
      border-color: #3BAD49;
      box-shadow: 0 10px 30px rgba(59, 173, 73, 0.06);
    }
    .pillar-trigger {
      padding: 24px 30px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      cursor: pointer;
      user-select: none;
    }
    .pillar-trigger__main {
      display: flex;
      align-items: center;
      gap: 20px;
    }
    .pillar-trigger__num {
      font-size: 20px;
      font-weight: 800;
      color: #3BAD49;
      opacity: 0.8;
      font-family: monospace;
    }
    .pillar-trigger__icon {
      color: var(--green);
      background: rgba(59, 173, 73, 0.06);
      width: 44px;
      height: 44px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .pillar-item.active .pillar-trigger__icon {
      background: var(--green);
      color: #fff;
    }
    .pillar-trigger__title {
      font-size: 18px;
      font-weight: 700;
      color: var(--main);
    }
    .pillar-chevron {
      transition: transform 0.3s;
      color: var(--gray-500);
    }
    .pillar-item.active .pillar-chevron {
      transform: rotate(180deg);
      color: #3BAD49;
    }
    
    /* Expandable content */
    .pillar-content {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    }
    .pillar-content__inner {
      padding: 0 30px 30px 94px;
    }
    @media(max-width: 640px) {
      .pillar-content__inner {
        padding: 0 20px 24px 20px;
      }
    }
    .pillar-content__desc {
      font-size: 15px;
      color: var(--gray-700);
      line-height: 1.7;
      margin-bottom: 24px;
    }
    
    /* Target Dashboard inside panel */
    .pillar-dashboard {
      background: var(--tertiary);
      border-radius: 12px;
      border: 1px solid var(--border);
      padding: 20px;
    }
    .pillar-dashboard__title {
      font-size: 13px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--primary);
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .pillar-dashboard__note {
      margin: -8px 0 16px;
      font-size: 13px;
      line-height: 1.6;
      color: var(--gray-500);
    }
    .pillar-grid-metrics {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
    @media(max-width: 640px) {
      .pillar-grid-metrics {
        grid-template-columns: 1fr;
        gap: 12px;
      }
    }
    .metric-box {
      background: var(--base);
      border: 1px solid rgba(0, 0, 0, 0.03);
      border-radius: 8px;
      padding: 14px;
    }
    .metric-box__lbl {
      font-size: 11px;
      color: var(--gray-500);
      font-weight: 600;
      text-transform: uppercase;
      margin-bottom: 4px;
    }
    .metric-box__val {
      font-size: 15px;
      font-weight: 700;
      color: var(--main);
      margin-bottom: 4px;
    }
    .metric-box__tip {
      font-size: 12px;
      color: var(--gray-700);
      line-height: 1.4;
    }

    /* 5. GÜNLÜK ROUTINE TIMELINE */
    .timeline-section {
      background: var(--tertiary);
      padding: 100px 0;
      border-top: 1px solid var(--border);
    }
    .timeline-header {
      text-align: center;
      max-width: 700px;
      margin: 0 auto 64px;
    }
    .timeline-header__title {
      font-family: Georgia, serif;
      font-size: clamp(28px, 4vw, 36px);
      font-weight: 700;
      margin-bottom: 16px;
      color: var(--main);
    }
    .timeline-header__desc {
      color: var(--gray-500);
      font-size: 16px;
      line-height: 1.6;
    }
    .v-timeline {
      max-width: 860px;
      margin: 0 auto;
      position: relative;
    }
    .v-timeline::before {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      left: 120px;
      width: 1px;
      background: var(--border);
    }
    @media(max-width: 768px) {
      .v-timeline::before {
        left: 20px;
      }
    }
    .v-time-item {
      display: grid;
      grid-template-columns: 120px 1fr;
      gap: 40px;
      margin-bottom: 48px;
      position: relative;
    }
    .v-time-item:last-child {
      margin-bottom: 0;
    }
    @media(max-width: 768px) {
      .v-time-item {
        grid-template-columns: 1fr;
        gap: 16px;
        padding-left: 48px;
      }
    }
    .v-time-item__time-col {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      padding-top: 4px;
    }
    @media(max-width: 768px) {
      .v-time-item__time-col {
        align-items: flex-start;
      }
    }
    .v-time-item__hour {
      font-size: 13px;
      font-weight: 700;
      color: var(--gray-700);
      background: var(--base);
      padding: 4px 14px;
      border-radius: 99px;
      border: 1px solid var(--border);
      white-space: nowrap;
    }
    .v-time-item__node {
      position: absolute;
      left: 121px;
      top: 10px;
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--green);
      transform: translateX(-50%);
      box-shadow: 0 0 0 4px rgba(59, 173, 73, 0.15);
      z-index: 2;
    }
    @media(max-width: 768px) {
      .v-time-item__node {
        left: 21px;
        top: 28px;
      }
    }
    .v-time-card {
      background: var(--base);
      border-radius: 20px;
      border: 1px solid var(--border);
      padding: 32px;
      box-shadow: 0 4px 16px rgba(0,0,0,0.01);
      transition: all 0.3s ease;
    }
    .v-time-card:hover {
      border-color: rgba(59, 173, 73, 0.25);
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(0,0,0,0.03);
    }
    .v-time-card__tag {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      padding: 4px 12px;
      border-radius: 99px;
      display: inline-block;
      margin-bottom: 16px;
    }
    .v-time-card__tag--morning { background: #fff6d6; color: #a07204; border: 1px solid rgba(160, 114, 4, 0.1); }
    .v-time-card__tag--midday { background: #e3f2fd; color: #1e62a8; border: 1px solid rgba(30, 98, 168, 0.1); }
    .v-time-card__tag--evening { background: #e8f5e9; color: #2e6035; border: 1px solid rgba(46, 96, 53, 0.1); }
    
    .v-time-card__title {
      font-size: 18px;
      font-weight: 700;
      margin-bottom: 18px;
      color: var(--main);
    }
    .v-time-card__list {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .v-time-card__step {
      font-size: 14px;
      line-height: 1.6;
      color: var(--gray-700);
      position: relative;
      padding-left: 18px;
    }
    .v-time-card__step::before {
      content: '•';
      position: absolute;
      left: 0;
      color: var(--green);
      font-weight: bold;
    }
    .v-time-card__step strong {
      color: var(--main);
    }

    /* 6. LATEST ARTICLES */
    .articles-section {
      background: var(--base);
      padding: 100px 0;
      border-top: 1px solid var(--border);
    }
    .articles-section .blog-grid {
      padding-top: 40px;
      padding-bottom: 0;
    }

    /* 7. PREMIUM CTA */
    .cta-section {
      background: var(--tertiary);
      padding: 0 0 100px;
    }
    .premium-cta {
      background: linear-gradient(145deg, #0d120e 0%, #070908 100%);
      border-radius: 24px;
      padding: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 64px;
      position: relative;
      overflow: hidden;
      border: 1px solid rgba(59, 173, 73, 0.15);
      box-shadow: 0 24px 48px rgba(0,0,0,0.15);
    }
    @media(max-width: 992px) {
      .premium-cta {
        flex-direction: column;
        padding: 48px 32px;
        text-align: center;
        gap: 40px;
      }
    }
    .premium-cta::before {
      content: '';
      position: absolute;
      bottom: -100px;
      right: -100px;
