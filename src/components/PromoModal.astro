---
// src/components/PromoModal.astro
---
<!-- PROMO POPUP MODAL -->
<div class="promo-modal" id="promoModal" aria-hidden="true" role="dialog">
  <div class="promo-modal__overlay"></div>
  <div class="promo-modal__content">
    <button class="promo-modal__close" id="closePromoModal" aria-label="Kapat">&times;</button>
    <div class="promo-modal__grid">
      <div class="promo-modal__img-wrap">
        <img src="/assets/images/generated/quiz_body_type.webp" alt="Vücut Tipi Quizi" class="promo-modal__img" />
      </div>
      <div class="promo-modal__body">
        <span class="promo-modal__badge">ÜCRETSİZ ANALİZ</span>
        <h2 class="promo-modal__title">#1 Sağlık Engelinizi Keşfedin</h2>
        <p class="promo-modal__desc">Biyolojik yaşınızı ve benzersiz vücut tipinizi sadece 2 dakikada öğrenin. Size özel hazırlanmış ücretsiz longevity ve beslenme protokolünüzü alın.</p>
        <div class="promo-modal__actions">
          <a href="/quizler" class="btn btn-primary btn-promo">Teste Başla &rarr;</a>
          <button class="btn-promo-skip" id="skipPromoModal">Daha Sonra</button>
        </div>
      </div>
    </div>
  </div>
</div>
