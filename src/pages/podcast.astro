---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const relatedPosts = allPosts
  .filter(post => ['Longevity', 'Stres', 'Hücre Sağlığı'].includes(post.data.category))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const slug = (id: string) => id.replace(/\.mdx?$/, '');
---
<BaseLayout title="Podcast — Dr. Muhammed İkbal Bakırcı" noindex>
  <style is:global>
    .pg-hero{background:var(--main);color:#fff;padding:80px 0;}
    .pg-hero__title{font-size:clamp(32px,5vw,52px);font-weight:900;margin-bottom:16px;}
    .pg-hero__sub{font-size:18px;opacity:.75;max-width:640px;}
    .episode-list{display:flex;flex-direction:column;gap:24px;padding:64px 0;max-width:820px;margin:0 auto;}
    .episode{display:flex;gap:24px;background:var(--base);border-radius:var(--r-lg);box-shadow:var(--shadow);overflow:hidden;}
    @media(max-width:640px){.episode{flex-direction:column;}}
    .episode__img{width:200px;flex-shrink:0;object-fit:cover;}
    @media(max-width:640px){.episode__img{width:100%;aspect-ratio:16/9;}}
    .episode__body{padding:24px;}
    .episode__no{font-size:11px;font-weight:700;letter-spacing:.5px;color:var(--blue);text-transform:uppercase;margin-bottom:8px;display:block;}
    .episode__title{font-size:19px;font-weight:800;margin-bottom:8px;}
    .episode__desc{font-size:14px;color:var(--gray-500);line-height:1.6;margin-bottom:12px;}
    .episode__note{font-size:12px;color:var(--gray-500);font-style:italic;}
  </style>

    <section class="pg-hero"><div class="container"><h1 class="pg-hero__title">Podcast</h1><p class="pg-hero__sub">Sağlık, beslenme ve yaşam üzerine sohbetler. Bölüm metinleri yayınlandıkça burada paylaşılacak.</p></div></section>
    <section class="section"><div class="container">
      <div style="max-width:600px;margin:0 auto 48px;background:var(--base);border-radius:var(--r-lg);padding:32px;box-shadow:var(--shadow);text-align:center;">
        <h2 style="font-size:20px;font-weight:800;margin-bottom:12px;">Bölüm Metni İste</h2>
        <p style="font-size:14px;color:var(--gray-500);margin-bottom:20px;">İstediğiniz bölümün transkriptini almak için bölüm numarasını belirterek WhatsApp'tan ulaşın.</p>
        <a href="https://wa.me/905442244813?text=Podcast%20b%C3%B6l%C3%BCm%20metni%20talep%20ediyorum" target="_blank" rel="noopener" class="btn btn-dark" style="display:inline-flex;align-items:center;gap:8px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Transkript İste
        </a>
      </div>
      <div class="episode-list">
        <article class="episode"><img loading="lazy" width="1200" height="800" src="/assets/images/generated/podcast_episode_1.webp" alt="Podcast Bölüm 1 - Longevity Giriş" class="episode__img" /><div class="episode__body"><span class="episode__no">Bölüm 1</span><h2 class="episode__title">İlk bölüm yakında</h2><p class="episode__desc">Bölüm açıklaması ve metni (transkript) yayınlandığında bu alanda yer alacak.</p><p class="episode__note">Bölüm metni eklenecek.</p></div></article>
        <article class="episode"><img loading="lazy" width="1200" height="800" src="/assets/images/generated/podcast_episode_2.webp" alt="Podcast Bölüm 2 - Hücresel Gençleşme" class="episode__img" /><div class="episode__body"><span class="episode__no">Bölüm 2</span><h2 class="episode__title">Yakında</h2><p class="episode__desc">Bölüm açıklaması ve metni (transkript) yayınlandığında bu alanda yer alacak.</p><p class="episode__note">Bölüm metni eklenecek.</p></div></article>
        <article class="episode"><img loading="lazy" width="1200" height="800" src="/assets/images/generated/podcast_episode_3.webp" alt="Podcast Bölüm 3 - Stres Yönetimi" class="episode__img" /><div class="episode__body"><span class="episode__no">Bölüm 3</span><h2 class="episode__title">Yakında</h2><p class="episode__desc">Bölüm açıklaması ve metni (transkript) yayınlandığında bu alanda yer alacak.</p><p class="episode__note">Bölüm metni eklenecek.</p></div></article>
      </div>
    </div></section>

  <!-- RELATED ARTICLES -->
  <section class="related-blogs-section" style="background: var(--tertiary); padding: 80px 0; border-top: 1px solid var(--border);">
    <div class="container">
      <div class="section-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px;">
        <h2 class="section-title">Podcast Konularıyla İlgili Sağlık Makaleleri</h2>
        <a href="/blog" class="section-link">Tüm Kütüphaneyi Gör &rarr;</a>
      </div>
      <div class="blog-grid" style="padding-top: 0; padding-bottom: 0;">
        {relatedPosts.map(post => (
          <article class="blog-card">
            <a href={`/blog/${slug(post.id)}`}>
              <img loading="lazy" width="1200" height="800" src={post.data.image} alt={post.data.title} class="blog-card__img" />
            </a>
            <div class="blog-card__body">
              <span class="blog-card__cat">{post.data.category}</span>
              <h2 class="blog-card__title">
                <a href={`/blog/${slug(post.id)}`}>{post.data.title}</a>
              </h2>
              <p class="blog-card__excerpt">{post.data.description}</p>
              <div class="blog-card__meta">
                <span>{post.data.date.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
                <span>{post.data.readTime} okuma</span>
              </div>
              <a href={`/blog/${slug(post.id)}`} class="blog-card__read-more">Devamını oku &rarr;</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
