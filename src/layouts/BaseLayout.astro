---
// src/layouts/BaseLayout.astro
import { ViewTransitions } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {
  DEFAULT_IMAGE,
  SITE_URL,
  SITE_NAME,
  getAbsoluteUrl,
  getCanonicalUrl,
  getPageDescription,
  buildSiteStructuredData,
  type PageType,
} from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  // Sayfaya özel JSON-LD düğümleri; sitenin tek @graph'ına eklenir (@context içermemeli).
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  pageType?: PageType;
  noindex?: boolean;
}

const {
  title,
  description: providedDescription,
  image = DEFAULT_IMAGE,
  type = 'website',
  publishedTime,
  modifiedTime,
  structuredData,
  pageType,
  noindex = false,
} = Astro.props;
// Yerel başlık tercihi: uzun başlıkta marka soneki kısalır (og:title tam kalır).
// Google sabit karakter sınırı koymaz; arama başlığını cihaz genişliğine göre gösterebilir.
const BRAND_SUFFIX = ' — Dr. Muhammed İkbal Bakırcı';
const SHORT_SUFFIX = ' | Dr. Bakırcı';
let documentTitle = title;
if (title.length > 60 && title.endsWith(BRAND_SUFFIX)) {
  const base = title.slice(0, -BRAND_SUFFIX.length);
  documentTitle = (base + SHORT_SUFFIX).length <= 60 ? base + SHORT_SUFFIX : base;
}
const description = getPageDescription(Astro.url.pathname, providedDescription);
const canonicalUrl = getCanonicalUrl(Astro.url.pathname);
const absoluteImage = getAbsoluteUrl(image);
// Bilinen görsel tipleri için paylaşım boyutu (varsayılan OG 1200x630, üretilmiş kapaklar 1200x800).
const imageSize = absoluteImage === DEFAULT_IMAGE ? [1200, 630] : /\/assets\/images\/generated\//.test(absoluteImage) ? [1200, 800] : null;
const siteStructuredData = buildSiteStructuredData({
  pathname: Astro.url.pathname,
  title,
  description,
  image,
  pageType,
});
const extraNodes = structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [];
const jsonLd = JSON.stringify({
  ...siteStructuredData,
  '@graph': [...siteStructuredData['@graph'], ...extraNodes],
}).replace(/</g, '\\u003c');
---
<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0c0f0d" />
  <title>{documentTitle}</title>
  <link rel="canonical" href={canonicalUrl} />
  <!-- Site simgeleri: scripts/favicon.mjs üretir. Google arama sonucundaki site simgesi bunlardan alınır. -->
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="alternate" hreflang="tr" href={canonicalUrl} />
  <meta property="og:type" content={type} />
  {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
  {type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
  {type === 'article' && <meta property="article:author" content={`${SITE_URL}/hakkinda`} />}
  <meta property="og:locale" content="tr_TR" />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={absoluteImage} />
  <meta property="og:image:alt" content={title} />
  {imageSize && <meta property="og:image:width" content={String(imageSize[0])} />}
  {imageSize && <meta property="og:image:height" content={String(imageSize[1])} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={absoluteImage} />
  <meta name="twitter:image:alt" content={title} />
  <script type="application/ld+json" set:html={jsonLd}></script>
  <link rel="preload" href="/assets/fonts/roboto/roboto-400.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/assets/fonts/roboto/roboto-700.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/style.css?v=20261006-blog-tables" />
  <link rel="stylesheet" href="/mobile-menu.css" />
  <ViewTransitions />
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
  <script src="/script.js" defer></script>
  <script src="/mobile-menu.js" defer></script>
</body>
</html>
