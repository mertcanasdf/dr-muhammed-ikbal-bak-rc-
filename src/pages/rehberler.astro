---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { sortPostsNewestFirst } from '../lib/posts';

const allPosts = await getCollection('blog');
const relatedPosts = sortPostsNewestFirst(
  allPosts.filter(post => ['Beslenme', 'Stres', 'Egzersiz'].includes(post.data.category)),
).slice(0, 3);

const slug = (id: string) => id.replace(/\.mdx?$/, '');
---
<BaseLayout title="Rehberler — Dr. Muhammed İkbal Bakırcı">
  <style is:global>
    .pg-hero{background:var(--main);color:#fff;padding:80px 0;}
    .pg-hero__title{font-size:clamp(32px,5vw,52px);font-weight:900;margin-bottom:16px;}
    .pg-hero__sub{font-size:18px;opacity:.75;max-width:640px;}
    .guides-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:28px;padding:64px 0;}
    @media(max-width:700px){.guides-grid{grid-template-columns:1fr;}}
    .guide-card{background:var(--base);border-radius:var(--r-lg);overflow:hidden;box-shadow:var(--shadow);transition:box-shadow .2s,transform .2s;}
    .guide-card:hover{box-shadow:var(--shadow-md);transform:translateY(-2px);}
    .guide-card__img{width:100%;aspect-ratio:16/9;object-fit:cover;}
    .guide-card__body{padding:24px;}
    .guide-card__tag{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--primary);background:var(--tertiary);padding:3px 10px;border-radius:99px;display:inline-block;margin-bottom:12px;}
    .guide-card__title{font-size:18px;font-weight:700;margin-bottom:8px;}
    .guide-card__desc{font-size:14px;color:var(--gray-500);line-height:1.6;margin-bottom:16px;}
    .guide-card__cta{font-size:13px;font-weight:700;color:var(--blue);}
    .guide-card__cta:hover{text-decoration:underline;}
  </style>

    <section class="pg-hero"><div class="container"><h1 class="pg-hero__title">Sağlık Rehberleri</h1><p class="pg-hero__sub">Bilimsel temelli, uygulaması kolay rehberler — beslenme ve metabolizma yönetiminden cilt sağlığına, uyku optimizasyonundan egzersiz protokollerine.</p></div></section>
    <section class="section"><div class="container">
      <div class="guides-grid">
        <div class="guide-card"><img src="/assets/images/generated/nutrition-longevity.webp" alt="Longevity başlangıcı için dengeli yaşam" class="guide-card__img" /><div class="guide-card__body"><span class="guide-card__tag">Başlangıç</span><h3 class="guide-card__title">Longevity'e Nasıl Başlarım?</h3><p class="guide-card__desc">Sıfırdan bir longevity protokolü oluşturmak için adım adım rehber. İlk 30 gün için somut eylem planı.</p><a href="/longevity" class="guide-card__cta">Okumaya başla &rarr;</a></div></div>
        <div class="guide-card"><img src="/assets/images/generated/guide_intermittent_fasting.webp" alt="Aralıklı oruç için taze sebzeler ve saat" class="guide-card__img" /><div class="guide-card__body"><span class="guide-card__tag">Beslenme</span><h3 class="guide-card__title">16:8 Aralıklı Oruç Kılavuzu</h3><p class="guide-card__desc">İlk haftadan itibaren nasıl uygulayacağınızı anlatan kapsamlı rehber. Yan etkiler ve çözümler dahil.</p><a href="/blog/aralikli-oruc-longevity" class="guide-card__cta">Makaleyi oku &rarr;</a></div></div>
        <div class="guide-card"><img src="/assets/images/generated/guide_keto_diet.webp" alt="Ketojenik beslenme için avokado ve sebzeler" class="guide-card__img" /><div class="guide-card__body"><span class="guide-card__tag">Beslenme</span><h3 class="guide-card__title">Ketojenik Diyete Geçiş</h3><p class="guide-card__desc">Yan etkileri minimize ederek ketoza nasıl girilir. Haftalık yemek planı ve alışveriş listesi.</p><a href="/blog/aralikli-oruc-longevity" class="guide-card__cta">Devamını oku &rarr;</a></div></div>
        <div class="guide-card"><img src="/assets/images/generated/stress-sleep.webp" alt="Uyku optimizasyonu için sakin gece rutini" class="guide-card__img" /><div class="guide-card__body"><span class="guide-card__tag">Uyku</span><h3 class="guide-card__title">Uyku Optimizasyonu Rehberi</h3><p class="guide-card__desc">Derin uyku evrelerini artırmak ve biyolojik saatinizi düzenlemek için uyku hijyeni ve günlük rutin önerileri.</p><a href="/blog/uyku-bozukluklari-ve-glymphatic-temizlik" class="guide-card__cta">Makaleyi oku &rarr;</a></div></div>
        <div class="guide-card"><img src="/assets/images/generated/exercise.webp" alt="Doğada longevity egzersizi" class="guide-card__img" /><div class="guide-card__body"><span class="guide-card__tag">Egzersiz</span><h3 class="guide-card__title">Longevity Egzersiz Programı</h3><p class="guide-card__desc">Bölge 2 kardiyo, ağırlık antrenmanı ve esneklik çalışmasını birleştiren haftalık program.</p><a href="/blog/bolge-2-kardiyo" class="guide-card__cta">Makaleyi oku &rarr;</a></div></div>
        <div class="guide-card"><img src="/assets/images/generated/guide_cortisol_stress.webp" alt="Kortizol kontrolü için sakin bir günlük rutin" class="guide-card__img" /><div class="guide-card__body"><span class="guide-card__tag">Stres</span><h3 class="guide-card__title">Kortizol Kontrol Protokolü</h3><p class="guide-card__desc">Kronik stresi yönetmek için günlük rutinler, meditasyon pratikleri ve beslenme stratejileri.</p><a href="/blog/kortizol-yaslanma" class="guide-card__cta">Makaleyi oku &rarr;</a></div></div>
        <div class="guide-card"><img src="/assets/images/generated/success-story.webp" alt="Cilt sağlığı ve dengeli yaşam" class="guide-card__img" /><div class="guide-card__body"><span class="guide-card__tag">Cilt Sağlığı</span><h3 class="guide-card__title">Cilt Sağlığı &amp; Gençleşme Rehberi</h3><p class="guide-card__desc">Cilt yaşlanmasını yavaşlatan beslenme stratejileri, takviyeler ve günlük bakım protokolü.</p><a href="/blog/senolitik-tedaviler-cilt-genclesmesi-zombi-hucreler" class="guide-card__cta">Okumaya başla &rarr;</a></div></div>
        <div class="guide-card"><img src="/assets/images/generated/online-course.webp" alt="Medikal estetik eğitimi ve klinik değerlendirme" class="guide-card__img" /><div class="guide-card__body"><span class="guide-card__tag">Medikal Estetik</span><h3 class="guide-card__title">Medikal Estetik Uygulamalar Rehberi</h3><p class="guide-card__desc">Hangi medikal estetik uygulamaların ne zaman tercih edileceğine dair kapsamlı değerlendirme kılavuzu.</p><a href="/medikal-estetik" class="guide-card__cta">Keşfet &rarr;</a></div></div>
      </div>
    </div></section>

  <!-- RELATED ARTICLES -->
  <section class="related-blogs-section" style="background: var(--tertiary); padding: 80px 0; border-top: 1px solid var(--border);">
    <div class="container">
      <div class="section-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px;">
        <h2 class="section-title">Rehberlik Eden Sağlık Makaleleri</h2>
        <a href="/blog" class="section-link">Tüm Kütüphaneyi Gör &rarr;</a>
      </div>
      <div class="blog-grid" style="padding-top: 0; padding-bottom: 0;">
        {relatedPosts.map(post => (
          <article class="blog-card">
            <a href={`/blog/${slug(post.id)}`}>
              <img src={post.data.image} alt={post.data.title} class="blog-card__img" />
            </a>
            <div class="blog-card__body">
              <span class="blog-card__cat">{post.data.category}</span>
              <h2 class="blog-card__title">
                <a href={`/blog/${slug(post.id)}`}>{post.data.title}</a>
              </h2>
              <p class="blog-card__excerpt">{post.data.description}</p>
              <div class="blog-card__meta">
                <span>{post.data.date.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
                <span>{post.data.readTime} okuma</span>
              </div>
              <a href={`/blog/${slug(post.id)}`} class="blog-card__read-more">Devamını oku &rarr;</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
