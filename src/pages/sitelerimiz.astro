---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Sitelerimiz — Dr. Muhammed İkbal Bakırcı">
  <style is:global>
    .pg-hero{background:var(--main);color:#fff;padding:80px 0;}
    .pg-hero__title{font-size:clamp(32px,5vw,52px);font-weight:900;margin-bottom:16px;}
    .pg-hero__sub{font-size:18px;opacity:.75;max-width:640px;}
    .sites-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;padding:64px 0;}
    @media(max-width:900px){.sites-grid{grid-template-columns:repeat(2,1fr);}}
    @media(max-width:600px){.sites-grid{grid-template-columns:1fr;}}
    .site-card{background:var(--base);border-radius:var(--r-lg);padding:32px;box-shadow:var(--shadow);text-align:center;transition:transform .2s,box-shadow .2s;}
    .site-card:hover{transform:translateY(-2px);box-shadow:var(--shadow-md);}
    .site-card__icon{font-size:48px;margin-bottom:16px;}
    .site-card__title{font-size:20px;font-weight:800;margin-bottom:10px;}
    .site-card__desc{font-size:14px;color:var(--gray-500);line-height:1.6;margin-bottom:20px;}
    .site-card__url{font-size:12px;color:var(--gray-500);margin-top:10px;}
  </style>

    <section class="pg-hero"><div class="container"><h1 class="pg-hero__title">Sitelerimiz</h1><p class="pg-hero__sub">Dr. Muhammed İkbal ekosistemi — araçlar, hesaplayıcılar ve uzman platformları.</p></div></section>
    <section class="section"><div class="container">
      <div class="sites-grid">
        <div class="site-card"><div class="site-card__icon">🥗</div><h3 class="site-card__title">Gıda Tarayıcı</h3><p class="site-card__desc">2 milyondan fazla gıdanın longevity skorunu anında görün. Barcode okuyucu ile alışverişte bilinçli seçimler yapın.</p><a href="/iletisim" class="btn btn-dark">Detaylı bilgi al</a><p class="site-card__url">gidatarayici.com</p></div>
        <div class="site-card"><div class="site-card__icon">🔢</div><h3 class="site-card__title">Keto Kalkulatörü</h3><p class="site-card__desc">Kişiselleştirilmiş makro hedefleri, ketoz takibi ve haftalık yemek planı oluşturma aracı.</p><a href="/iletisim" class="btn btn-dark">Detaylı bilgi al</a><p class="site-card__url">ketokalkulator.com</p></div>
        <div class="site-card"><div class="site-card__icon">💊</div><h3 class="site-card__title">Takviye Rehberi</h3><p class="site-card__desc">Hangi takviyeyi, ne dozda, ne zaman alacağınızı öğrenin. Etkileşim kontrolü dahil.</p><a href="/iletisim" class="btn btn-dark">Detaylı bilgi al</a><p class="site-card__url">takviyelongevity.com</p></div>
        <div class="site-card"><div class="site-card__icon">📊</div><h3 class="site-card__title">Lab Değer Yorumlayıcı</h3><p class="site-card__desc">Kan tahlili sonuçlarınızı longevity perspektifinden yorumlayın. Optimal aralıkları öğrenin.</p><a href="/iletisim" class="btn btn-dark">Detaylı bilgi al</a><p class="site-card__url">labdegerleri.com</p></div>
        <div class="site-card"><div class="site-card__icon">🏃</div><h3 class="site-card__title">Bölge 2 Kardiyo Takip</h3><p class="site-card__desc">Kalp atış hızı bölgelerinizi hesaplayın ve Bölge 2 antrenmanlarınızı optimize edin.</p><a href="/iletisim" class="btn btn-dark">Detaylı bilgi al</a><p class="site-card__url">bolge2.com</p></div>
        <div class="site-card"><div class="site-card__icon">😴</div><h3 class="site-card__title">Uyku Skoru</h3><p class="site-card__desc">Uyku kalitesini etkileyen faktörleri değerlendirin ve kişiselleştirilmiş optimizasyon önerileri alın.</p><a href="/iletisim" class="btn btn-dark">Detaylı bilgi al</a><p class="site-card__url">uykuskoru.com</p></div>
      </div>
    </div></section>
</BaseLayout>
