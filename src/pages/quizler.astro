        { text: 'Uyku sorununuzdan ne kadar endişe veya rahatsızlık duyuyorsunuz?', options: [{ label: 'Hiç endişe duymuyorum', pts: 0 }, { label: 'Biraz', pts: 1 }, { label: 'Orta düzeyde', pts: 2 }, { label: 'Çok endişe duyuyorum', pts: 3 }, { label: 'Aşırı derecede endişe duyuyorum', pts: 4 }] },
        { text: 'Uyku sorununuzun gündüz işlevselliğinizi (iş, sosyal yaşam, günlük görevler) ne ölçüde etkilediğini düşünüyorsunuz?', options: [{ label: 'Hiç etkilemiyor', pts: 0 }, { label: 'Biraz etkiliyor', pts: 1 }, { label: 'Orta düzeyde etkiliyor', pts: 2 }, { label: 'Çok etkiliyor', pts: 3 }, { label: 'Aşırı derecede etkiliyor', pts: 4 }] },
      ],
      scoring: 'points',
      maxPoints: 28,
      levels: [
        { min: 0, max: 7, label: 'İnsomnia Yok', title: 'Klinik Olarak Anlamlı İnsomnia Yok', pct: 92, desc: 'ISI skorunuz klinik insomnia eşiğinin altında. Uyku kaliteniz genel olarak iyi görünüyor.', tips: ['Uyku hijyeninizi koruyun', 'Düzenli uyku-uyanış saati biyolojik saatinizi güçlendirir', 'Ekran süresini yatmadan 1 saat önce sınırlandırın'] },
        { min: 8, max: 14, label: 'Subklinik', title: 'Subklinik İnsomnia — Dikkat Edilmesi Önerilir', pct: 65, desc: 'ISI skorunuz eşik altı (subklinik) insomniaya işaret ediyor. Bu düzey kronik soruna dönüşebilir.', tips: ['Kafein tüketimini öğlen 12\'den sonra bırakın', 'Yatak odasını 18–20°C arasında tutun', 'Uyku için takviye kullanmadan önce hekiminize danışın', 'Melatonin gibi ürünleri hekiminize danışmadan kullanmayın', 'Yatakta yalnızca uykulu olduğunuzda kalın'] },
        { min: 15, max: 21, label: 'Orta İnsomnia', title: 'Orta Düzey Klinik İnsomnia', pct: 40, desc: 'ISI skorunuz orta düzey klinik insomniaya işaret ediyor. Uyku problemi günlük işlevselliğinizi etkiliyor.', tips: ['Bilişsel Davranışçı Terapi - İnsomnia (BDT-I) birinci seçenek tedavidir', 'Uyarım kontrolü: yatak sadece uyku için kullanılmalı', 'Uyku kısıtlaması terapisi (SRT) uyku verimliliğini artırır', 'Bir uyku uzmanına veya psikiyatriste başvurun', 'Uyku apnesi ve RLS değerlendirin'] },
        { min: 22, max: 28, label: 'Ağır İnsomnia', title: 'Ağır Klinik İnsomnia — Klinik Değerlendirme Gerekli', pct: 15, desc: 'ISI skorunuz ağır klinik insomniaya işaret ediyor. Kapsamlı değerlendirme ve tedavi planı için bir uyku uzmanıyla görüşmeniz önerilir.', tips: ['Uyku bozukluğu kliniğine veya uyku uzmanına başvurun', 'Uyku polisomnografisi (uyku testi) değerlendirilebilir', 'BDT-I en güçlü kanıta sahip tedavidir', 'Uyku apnesi değerlendirmesi için KBB veya göğüs hastalıkları konsültasyonu', 'Eşlik eden depresyon ve anksiyete araştırılmalı'] },
      ]
    }
  };

  let activeQuiz = null;
  let currentQ = 0;
  let answers = [];

  function openQuiz(key) {
    activeQuiz = QUIZZES[key];
    currentQ = 0;
    answers = new Array(activeQuiz.questions.length).fill(null);
    document.getElementById('modalTitle').textContent = activeQuiz.title;
    document.getElementById('modalMeta').textContent = activeQuiz.meta;
    renderQuestion();
    const modal = document.getElementById('quizModal');
    modal.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  }

  function closeQuiz() {
    document.getElementById('quizModal').classList.remove('is-open');
    document.body.style.overflow = '';
  }

  document.getElementById('quizModal').addEventListener('click', function(e) {
    if (e.target === this) closeQuiz();
  });

  function renderQuestion() {
    const q = activeQuiz.questions[currentQ];
    const total = activeQuiz.questions.length;
    const pct = Math.round((currentQ / total) * 100);
    document.getElementById('progressFill').style.width = pct + '%';
    let html = `<div class="q-step is-active">
      <div class="q-number">Soru ${currentQ + 1} / ${total}</div>
      <div class="q-text" id="qText">${q.text}</div>
      <div class="q-options" role="group" aria-labelledby="qText">`;
    q.options.forEach((opt, i) => {
      const isSel = answers[currentQ] === i;
      html += `<button type="button" class="q-option${isSel ? ' selected' : ''}" aria-pressed="${isSel}" onclick="selectOption(${i})">
        <span class="q-option__dot" aria-hidden="true"></span>
        <span class="q-option__label">${opt.label}</span>
      </button>`;
    });
    html += `</div>
      <div class="q-nav">
        <button class="q-nav__back" onclick="prevQuestion()" ${currentQ === 0 ? 'style="visibility:hidden"' : ''}>&#8592; Geri</button>
        <button class="btn btn-dark q-nav__next" onclick="nextQuestion()" ${answers[currentQ] === null ? 'disabled style="opacity:.4;cursor:default"' : ''}>
          ${currentQ < total - 1 ? 'Devam &#8594;' : 'Sonuçları Gör'}
        </button>
      </div>
    </div>`;
    document.getElementById('modalBody').innerHTML = html;
  }

  function selectOption(i) {
    answers[currentQ] = i;
    const opts = document.querySelectorAll('.q-option');
    opts.forEach((o, idx) => {
      o.classList.toggle('selected', idx === i);
      o.setAttribute('aria-pressed', String(idx === i));
    });
    const btn = document.querySelector('.q-nav__next');
    btn.removeAttribute('disabled');
    btn.removeAttribute('style');
  }

  function nextQuestion() {
    if (answers[currentQ] === null) return;
    if (currentQ < activeQuiz.questions.length - 1) {
      currentQ++;
      renderQuestion();
    } else {
      showResult();
    }
  }

  function prevQuestion() {
    if (currentQ > 0) { currentQ--; renderQuestion(); }
  }

  function showResult() {
    document.getElementById('progressFill').style.width = '100%';
    const q = activeQuiz;
    if (q.scoring === 'type') {
      const tally = { adrenal: 0, tiroid: 0, karaciger: 0, over: 0 };
      answers.forEach((ansIdx, qIdx) => {
        if (ansIdx !== null) {
          const t = q.questions[qIdx].options[ansIdx].type;
          tally[t]++;
        }
      });
      const winner = Object.entries(tally).sort((a, b) => b[1] - a[1])[0][0];
      renderResult(q.types[winner]);
    } else {
      let total = 0;
      answers.forEach((ansIdx, qIdx) => {
        if (ansIdx !== null) total += q.questions[qIdx].options[ansIdx].pts;
      });
      const level = q.levels.find(l => total >= l.min && total <= l.max) || q.levels[q.levels.length - 1];
      const pctScore = Math.round((total / q.maxPoints) * 100);
      renderResult({ ...level, pct: pctScore });
    }
  }

  function renderResult(r) {
    const tipsHTML = r.tips.map(t => `<li>${t}</li>`).join('');
    const html = `<div class="q-result is-active">
      <div class="q-result__label">${r.label}</div>
      <h3 class="q-result__title">${r.title}</h3>
      <div class="q-result__score-bar"><div class="q-result__score-fill" id="scoreFill" style="width:0%"></div></div>
      <div class="q-result__desc">${r.desc}</div>
      <div class="q-result__tips"><h4>Önerilen Adımlar</h4><ul>${tipsHTML}</ul></div>
      <p class="q-result__note">Bu sonuç bilgilendirme amaçlıdır ve tanı koymaz. Sonucunuzla ilgili endişeniz varsa bir hekime ya da ruh sağlığı uzmanına başvurun.</p>
      <div class="q-result__actions">
        <button class="q-result__retake" onclick="retakeQuiz()">Tekrar Al</button>
        <a href="/iletisim" class="btn btn-dark">Uzmanla Görüş</a>
      </div>
    </div>`;
    document.getElementById('modalBody').innerHTML = html;
    setTimeout(() => {
      document.getElementById('scoreFill').style.width = r.pct + '%';
    }, 100);
  }

  function retakeQuiz() {
    currentQ = 0;
    answers = new Array(activeQuiz.questions.length).fill(null);
    document.getElementById('progressFill').style.width = '0%';
    renderQuestion();
  }
  </script>
</BaseLayout>
